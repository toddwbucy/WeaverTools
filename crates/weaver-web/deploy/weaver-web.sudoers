# weaver-web lifecycle verbs (Spec section 11). Install as
# /etc/sudoers.d/weaver-web (mode 0440, visudo -c to verify).
# The one privilege widening the application asks of the box: the three
# lifecycle verbs on the admin binary, nothing else.
todd ALL=(root) NOPASSWD: /usr/local/libexec/weaver/weaver-admin validate *, /usr/local/libexec/weaver/weaver-admin load *, /usr/local/libexec/weaver/weaver-admin unload *
# The verb runner passes the config location through sudo's environment.
Defaults!/usr/local/libexec/weaver/weaver-admin env_keep += "WEAVER_ADMIN_CONFIG"
