#!/bin/bash
# Guest side of clone.sh: one function per step, run as the guest's operator account.
# The deploy scripts run unmodified from the WeaverAgent checkout the template carries.
set -uo pipefail

WA=$HOME/WeaverAgent
MODEL=qwen2.5-0.5b-instruct-q6_k.gguf
ARTIFACT=/opt/weaver/models/$MODEL
export CARGO_TARGET_DIR=$HOME/target/weaveragent
export PATH=/usr/local/cuda/bin:$HOME/.cargo/bin:$PATH
export CUDA_LIB_DIR=/usr/local/cuda/lib64
section() { printf '\n== %s\n' "$*"; }

# The clone's identity, against the template's as the template's facts step read it.
identity() {
    section hostname; hostname
    section machine-id; cat /etc/machine-id
    section host-keys
    for k in /etc/ssh/ssh_host_*_key.pub; do ssh-keygen -lf "$k"; done
    section cloud-init; cloud-init status --long | head -6
    section network; ip -4 -o addr show scope global; sudo nft list ruleset
    section stack; head -3 /etc/weaver/stack/install-tuple; ls /etc/weaver/admin | wc -l
    section trees; git -C "$WA" rev-parse HEAD; git -C "$WA" status --porcelain | head
}

# The models share as the guest sees it.
models() {
    section mount; findmnt /opt/weaver/models || echo "not mounted"
    section listing; ls -ln /opt/weaver/models | head -20
    section artifact; stat -c '%n uid %u gid %g mode %a size %s' "$ARTIFACT"
    section held-closed
    for p in "$ARTIFACT" /opt/weaver/models /opt/weaver /opt /; do
        stat -c '%n uid %u gid %g mode %a' "$p"
    done
    section read; time sha256sum "$ARTIFACT"
    section write-refused-by-the-guest-mount
    sudo touch /opt/weaver/models/.write-probe 2>&1; echo "touch exit $?"
}

# Only where the host's virtiofsd was confirmed to run read-only: remount the share
# read-write in the guest and try a write as root, which the host side must refuse.
models_host_refusal() {
    sudo mount -o remount,rw /opt/weaver/models 2>&1; echo "remount exit $?"
    findmnt -no OPTIONS /opt/weaver/models
    sudo touch /opt/weaver/models/.write-probe 2>&1; echo "touch exit $?"
    sudo rm -f /opt/weaver/models/.write-probe 2>/dev/null
    sudo mount -o remount,ro /opt/weaver/models 2>&1
    findmnt -no OPTIONS /opt/weaver/models
}

# relaxed COMMAND...: as guest/template-steps states it. verify-lifecycle.sh's step 0
# runs update-stack.sh's plan, whose test step needs both settings.
relaxed() {
    local rc=0 mask lock=${RELAXED_LOCK:-$HOME/.weaver-relaxed.lock}
    # One relaxed step at a time in this guest. A second step that started while the
    # first had both settings relaxed would save the relaxed values as its own and put
    # them back after the first restored, and both would pass. So the lock is taken
    # before the two reads and never given back by hand: its descriptor stays open for
    # this shell's life, the restore runs under it on every way out, and the kernel frees
    # it however the shell ends. A step that finds it held, or cannot open or take it, is
    # refused at once with nothing changed; it never runs unlocked. The file is 0600 in
    # the operator's home, where the checkout and cargo's target are, so its directory is
    # there, and no other account can open the file to hold the lock.
    mask=$(umask)
    umask 077
    if ! exec {relaxed_lock_fd}>>"$lock"; then
        umask "$mask"
        echo "relaxed: cannot open the lock $lock; nothing relaxed" >&2
        return 1
    fi
    umask "$mask"
    flock -n "$relaxed_lock_fd" || {
        echo "relaxed: the lock $lock is held by another relaxed step or cannot be taken; nothing relaxed" >&2
        return 1
    }
    # The two settings as they were, kept global: after an unset variable under set -u,
    # bash unwinds every function before the EXIT trap runs, and a local would be gone.
    relaxed_userns=$(sysctl -n kernel.apparmor_restrict_unprivileged_userns) || return 1
    relaxed_sh=$(readlink /bin/sh)
    [ -n "$relaxed_sh" ] || { echo "/bin/sh is not a link; nothing relaxed"; return 1; }
    # Both settings come back on every way out of this shell once the traps are set,
    # so a step that stops does not leave /bin/sh -> bash in an image that is then
    # sealed:
    #   - a failed change, and the wrapped command's end;
    #   - an exit inside the wrapped command, which is a shell function in this shell
    #     (an `exit`, or an unset variable under set -u);
    #   - INT, HUP or TERM sent to the step;
    #   - SIGPIPE, the dropped SSH session. sshd sends a command without a terminal no
    #     signal when the client goes away, but it closes the command's pipes, and the
    #     next write by this shell (a wrapped function's printf) would end it untrapped.
    # Each signal exits with its own status, and the EXIT trap restores. A restore that
    # does not read back both settings as they were fails the step, even after a
    # command that passed.
    relaxed_restore() {
        local bad=0 now_sh now_userns
        sudo ln -sfn "$relaxed_sh" /bin/sh || bad=1
        sudo sysctl -q -w kernel.apparmor_restrict_unprivileged_userns="$relaxed_userns" || bad=1
        now_sh=$(readlink /bin/sh)
        now_userns=$(sysctl -n kernel.apparmor_restrict_unprivileged_userns)
        [ "$now_sh" = "$relaxed_sh" ] && [ "$now_userns" = "$relaxed_userns" ] || bad=1
        if [ "$bad" = 0 ]; then
            echo "restored: kernel.apparmor_restrict_unprivileged_userns=$now_userns, /bin/sh -> $now_sh"
        else
            echo "NOT RESTORED: kernel.apparmor_restrict_unprivileged_userns=$now_userns (was $relaxed_userns), /bin/sh -> $now_sh (was $relaxed_sh)" >&2
        fi
        return "$bad"
    }
    # On the way out: the exit status stands, but a 0 becomes 1 when the restore fails.
    relaxed_on_exit() {
        local st=$1
        relaxed_restore || [ "$st" != 0 ] || st=1
        exit "$st"
    }
    trap 'relaxed_on_exit $?' EXIT
    trap 'exit 130' INT
    trap 'exit 129' HUP
    trap 'exit 143' TERM
    trap 'exit 141' PIPE
    if ! sudo sysctl -q -w kernel.apparmor_restrict_unprivileged_userns=0 || ! sudo ln -sfn bash /bin/sh; then
        relaxed_restore
        trap - EXIT INT HUP TERM PIPE
        return 1
    fi
    echo "relaxed: kernel.apparmor_restrict_unprivileged_userns=0, /bin/sh -> bash"
    # The command runs with the lock's descriptor closed, so nothing it leaves running
    # holds the lock after this shell ends; the shell keeps it meanwhile.
    "$@" {relaxed_lock_fd}>&- || rc=$?
    relaxed_restore || [ "$rc" != 0 ] || rc=1
    trap - EXIT INT HUP TERM PIPE
    return "$rc"
}

# The `test` the deploy scripts run as another account (`sudo -u <account> test -r`),
# against a file the account reads through its primary group and one it reads through
# a supplementary group, beside an actual read and bash's builtin test. Run as the box's
# admin-con account, which create-agent.sh joins to an agent's groups.
coreutils_probe() {
    local d acct=weaver-admincon g
    section coreutils
    readlink -f /usr/bin/test; /usr/bin/test --version 2>&1 | head -1
    dpkg-query -W -f '${Package} ${Version}\n' coreutils-from-uutils coreutils-from-gnu \
        rust-coreutils gnu-coreutils 2>/dev/null
    section account; sudo -u "$acct" id
    d=$(mktemp -d); sudo chmod 0755 "$d"
    for g in "$acct" $(id -Gn "$acct" | tr ' ' '\n' | grep -vx "$acct" | head -1); do
        sudo install -o root -g "$g" -m 0640 /dev/null "$d/f"
        section "file root:$g 0640, $acct's $( [ "$g" = "$acct" ] && echo primary || echo supplementary) group"
        sudo -u "$acct" /usr/bin/test -r "$d/f"; echo "/usr/bin/test -r: exit $?"
        sudo -u "$acct" bash -c "test -r '$d/f'"; echo "bash builtin test -r: exit $?"
        sudo -u "$acct" cat "$d/f" >/dev/null; echo "cat (an actual read): exit $?"
    done
    sudo rm -rf "$d"
}

# GNU's test ahead of the Rust coreutils' one, in this clone only. Ubuntu's own switch
# (coreutils-from-gnu in place of coreutils-from-uutils) would remove the packages
# listed first, so instead GNU's test, which Ubuntu ships as gnutest, is linked into
# /usr/local/bin, which sudo's secure_path searches before /usr/bin. No file a package
# owns is changed.
gnu_test() {
    section what-the-package-switch-would-remove
    sudo apt-get install -s coreutils-from-gnu coreutils-from-uutils- 2>&1 | grep -E '^Remv' | awk '{print $2}'
    sudo grep -rh secure_path /etc/sudoers /etc/sudoers.d/ 2>/dev/null
    sudo ln -sfn /usr/bin/gnutest /usr/local/bin/test
    sudo ln -sfn '/usr/bin/gnu[' '/usr/local/bin/['
    ls -l /usr/local/bin/test '/usr/local/bin/['
    sudo -u weaver-admincon sh -c 'command -v test; type test'
    coreutils_probe_as_sudo_path
}

# coreutils_probe, with test found as `sudo -u <account> test` finds it.
coreutils_probe_as_sudo_path() {
    local d acct=weaver-admincon g
    d=$(mktemp -d); sudo chmod 0755 "$d"
    for g in "$acct" $(id -Gn "$acct" | tr ' ' '\n' | grep -vx "$acct" | head -1); do
        sudo install -o root -g "$g" -m 0640 /dev/null "$d/f"
        section "file root:$g 0640, $acct's $( [ "$g" = "$acct" ] && echo primary || echo supplementary) group"
        sudo -u "$acct" test -r "$d/f"; echo "sudo -u $acct test -r: exit $?"
        sudo -u "$acct" cat "$d/f" >/dev/null; echo "cat (an actual read): exit $?"
    done
    sudo rm -rf "$d"
}

# The sudo rule create-agent.sh renders for an agent (its Defaults line and one grant),
# checked by each visudo Ubuntu ships; then Ubuntu's own switch of the sudo alternative
# from sudo-rs to the original sudo, in this clone only.
sudo_ws() {
    local f
    f=$(mktemp)
    printf '%s\n' '# the shape deploy/create-agent.sh renders' \
        'Defaults:weaver-admincon !pam_session' \
        'weaver-admincon ALL=(root) NOPASSWD: /opt/weaver/bin/weaver-admin show probe1, /opt/weaver/bin/weaver-admin load probe1' >"$f"
    section before; update-alternatives --query sudo | grep -E '^(Value|Best)'
    sudo --version | head -1
    for v in /usr/lib/cargo/bin/visudo /usr/sbin/visudo.ws; do
        section "$v -cf"; sudo "$v" -cf "$f" 2>&1; echo "exit $?"
    done
    rm -f "$f"
    sudo update-alternatives --set sudo /usr/bin/sudo.ws || return 1
    section after; update-alternatives --query sudo | grep -E '^(Value|Best)'
    sudo --version | head -1; readlink -f /usr/sbin/visudo
}

# The stack scripts' test step alone (update-stack.sh run_tests, the same command and
# target directory), once, with the guest's load beside it.
test_step() {
    local log rc=0
    log=$(mktemp)
    printf 'guest load before: %s\n' "$(cut -d' ' -f1-3 /proc/loadavg)"
    (cd "$WA" && cargo test --release --locked -p weaver-trace -p weaver-harness -p weaver-state \
        --features weaver-state/sqlite) >"$log" 2>&1 || rc=$?
    printf 'guest load after: %s\n' "$(cut -d' ' -f1-3 /proc/loadavg)"
    echo "cargo exit $rc"
    grep -E '^test result: FAILED|panicked at' "$log" | head -8
    awk '/^test result: (ok|FAILED)\. [0-9]+ passed; [0-9]+ failed;/ {p+=$4; f+=$6} END {print "passed", p+0, "failed", f+0}' "$log"
    rm -f "$log"
    return "$rc"
}

# loopback-probe PORT...: a TCP connect, no protocol, to each port at the host's two
# user-mode aliases (10.0.2.2, and fec0::2 for IPv6), an outbound control, and an
# endpoint a guestfwd may name (10.0.2.100:8080); with the guard's counters.
loopback_probe() {
    section addresses; ip -o addr show scope global | awk '{print $2, $3, $4}'
    ip -6 route show 2>/dev/null | head -3
    section connects
    python3 - "$@" <<'PY'
import socket, sys
def probe(host, port, fam):
    s = socket.socket(fam, socket.SOCK_STREAM); s.settimeout(3)
    try:
        s.connect((host, port)); return "connects"
    except Exception as e:
        return "no-connect (%s)" % type(e).__name__
    finally:
        s.close()
for port in map(int, sys.argv[1:]):
    print("10.0.2.2:%d %s" % (port, probe("10.0.2.2", port, socket.AF_INET)))
    print("[fec0::2]:%d %s" % (port, probe("fec0::2", port, socket.AF_INET6)))
print("github.com:443 (outbound control) %s" % probe("github.com", 443, socket.AF_INET))
print("10.0.2.100:8080 (a guestfwd, where one is set) %s" % probe("10.0.2.100", 8080, socket.AF_INET))
PY
    section guard; sudo nft list table inet hostguard 2>&1
}

lifecycle_plan() {
    cd "$WA" && bash deploy/verify-lifecycle.sh --agent "$1"
}

lifecycle() {
    cd "$WA" && bash deploy/verify-lifecycle.sh --agent "$1" --artifact "$ARTIFACT" --apply
}

lifecycle_cleanup() {
    cd "$WA" && bash deploy/verify-lifecycle.sh --agent "$1" --cleanup --apply
}

create_plan() {
    cd "$WA" && bash deploy/create-agent.sh "$1" --artifact "$ARTIFACT"
}

create_apply() {
    cd "$WA" && bash deploy/create-agent.sh "$1" --artifact "$ARTIFACT" --apply
}

validate() {
    sudo /opt/weaver/bin/weaver-admin validate "$1"
}

# The load, as admin's verb runs it; expected to refuse on a box without a card.
load() {
    sudo /opt/weaver/bin/weaver-admin load "$1"; echo "load exit $?"
    section admin-log; sudo tail -40 "/var/lib/weaver-agent/weaver-$1/admin.log" 2>&1
    section worker-log; sudo tail -40 "/var/lib/weaver-agent/weaver-$1/worker.log" 2>&1
    section show; sudo /opt/weaver/bin/weaver-admin show "$1" 2>&1 | head -30
}

case ${1:-} in
identity) identity ;;
models) models ;;
models-host-refusal) models_host_refusal ;;
coreutils-probe) coreutils_probe ;;
gnu-test) gnu_test ;;
sudo-ws) sudo_ws ;;
test-step) relaxed test_step ;;
loopback-probe) shift; loopback_probe "$@" ;;
lifecycle-plan) lifecycle_plan "$2" ;;
lifecycle) lifecycle "$2" ;;
lifecycle-relaxed) relaxed lifecycle "$2" ;;
lifecycle-cleanup) lifecycle_cleanup "$2" ;;
create-plan) create_plan "$2" ;;
create-apply) create_apply "$2" ;;
validate) validate "$2" ;;
load) load "$2" ;;
*) echo "unknown step: ${1:-}" >&2; exit 2 ;;
esac
