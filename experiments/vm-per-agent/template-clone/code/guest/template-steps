#!/bin/bash
# Guest side of build-template.sh: one function per step, run as the build account over
# SSH. The appliance image is compiled here, in its own OS: both repositories are cloned
# at their named commits and built in this guest, the build's tools are removed by a
# checked list, and the seal writes the stamp and then the MANIFEST last
# (weaver-appliance-build-Spec, section 2). Each step prints what it measured; a step
# that fails exits non-zero and the host keeps its output. Nothing here is a WeaverAgent
# or WeaverWeb script; the deploy scripts run unmodified from their checkouts.
#
# Release 1.1 builds on Arch Linux, pinned (the operator's ruling of 2026-11-16): the
# arch-boxes cloud image lib.sh names, brought to one day of the Arch Linux Archive and
# never past it. Release 1.0 was built on Ubuntu 26.04 by this file as tagged
# appliance/1.0.
set -uo pipefail

# The inputs, named by the host on each step's command line: VERSION (the image's version,
# a release, <release>.0), WA_COMMIT and WW_COMMIT in full, DRIVER, DRIVER_ROUTE,
# COMPUTE_CAP, and BASE_IMAGE (the cloud image's name and digest). A step that needs one
# refuses where it is unset.
WA_URL=https://github.com/toddwbucy/WeaverAgent.git
WW_URL=https://github.com/toddwbucy/WeaverWeb.git
# The pins this file holds. Every package comes from one day of the Arch Linux Archive, the
# snapshot below, and the versions after it are that day's, read on 2026-11-16 from the
# day's core and extra databases. A version that reads otherwise after the update refuses.
TOOLCHAIN=nightly-2026-02-13                        # both trees' rust-toolchain.toml
ARCHIVE_DAY=2026/11/15
ARCHIVE=https://archive.archlinux.org/repos/$ARCHIVE_DAY
PIN_LINUX=7.3.4.arch1-2                             # the kernel package
PIN_KVER=7.3.4-arch1-2                              # its release, as uname -r prints it
PIN_CUDA=13.4.3-1                                   # nvcc 13.4; cudart and NVRTC 13.4.92
PIN_NVIDIA=620.70.06                                # the driver release
PIN_NVIDIA_OPEN=620.70.06-3                         # the module, prebuilt for PIN_KVER
PIN_NVIDIA_UTILS=620.70.06-1                        # its userspace, at the module's version
# CCCL 3.3.4: the one package from outside the snapshot (the Planner's ruling of
# 2026-11-16). The day's cccl is 3.5.0, outside the window WeaverAgent's bootstrap accepts
# (3.1.4 to 3.3.4), so this host's measured pairing is pinned from the archive's package
# store by digest, its signature checked against the build guest's keyring. It is a build
# package: the cleanup purges it, and the stamp records it.
CCCL_PIN=3.3.4-1
CCCL_PKG=cccl-$CCCL_PIN-any.pkg.tar.zst
CCCL_URL=https://archive.archlinux.org/packages/c/cccl/$CCCL_PKG
CCCL_SHA256=71107144147f149f81532bad5bf92ca52ac82f5e204065e7279b937fd3a409e9
# nvcc's host compiler: g++ 15 from gcc15, as release 1.0 compiled (the Planner's ruling of
# 2026-11-16). Arch's cuda.sh would name its base g++ (16).
CXX_MAJOR=15
CUDA_HOME=/opt/cuda
# The canonical CUDA library directory. The loader reaches it through /opt/cuda/lib64, the
# link cuda.conf names.
CUDA_LIBS=$CUDA_HOME/targets/x86_64-linux/lib
# candle's kernels read the compute capability from a card. The build guest has none, so it
# is a named input, COMPUTE_CAP (the capability without its dot, such as 86 for 8.6), which
# the stack step refuses without and the stamp records.
COMPUTE_CAP=${COMPUTE_CAP:-}
# os-release is read in subshells and never sourced here: it assigns VERSION, which would
# replace the image's version the host names (the Planner's review of 2026-11-15, B1).
# shellcheck source=/dev/null
OS_ID=$(. /etc/os-release && printf '%s' "${ID:-}")
# shellcheck source=/dev/null
PRETTY_NAME=$(. /etc/os-release && printf '%s' "${PRETTY_NAME:-}")
[ "$OS_ID" = arch ] || { echo "no build for os-release ID '$OS_ID' (this file builds Arch Linux)" >&2; exit 2; }
KVER=$(uname -r)
# No dkms and no kernel headers: the driver's module comes prebuilt (driver, below).
# base-devel holds the C toolchain, make, patch, fakeroot and makepkg's helpers; clang
# carries libclang; openssl its headers.
PACKAGES="base-devel gcc$CXX_MAJOR git curl ca-certificates cmake clang pkgconf python bzip2
  make acl openssl jq sqlite"

# The build's fixed layout: one account (op, made by the seed), one checkout path and one
# target path, since the binaries carry their build paths (the WeaverAgent seat counted
# 221 such strings in weaver-spu) and two builds match only where these are the same.
WA=$HOME/WeaverAgent
WW=$HOME/WeaverWeb
export CARGO_TARGET_DIR=$HOME/target/weaveragent
export PATH=$HOME/.cargo/bin:$PATH
# The build's own records, root's, removed by the seal once the stamp is written.
BUILD=/var/lib/weaver-build
# The image's record and the deploy scripts' fixed copy (the appliance's layout).
RECORD=/etc/weaver-appliance
DEPLOY_COPY=/opt/weaver/deploy
# The sealed image's hostname, set by the seal in place of the build guest's own: a neutral
# name, so a box does not greet with the build's name (the Planner's note of 2026-11-15).
# Defined once, here: lib.sh reads it for proof.
IMAGE_HOSTNAME='weaver-appliance'
# The two data mount points the appliance's profile fixes (weaver-appliance-profile section
# 3.4): the operator attaches the disks and mounts them here. The image lays them empty and
# root's, and carries no model and no state. Whether a load finds a separate filesystem on
# each is admin's test, at every load, not the image's. Defined once, here: lib.sh reads it
# for proof.
DATA_MOUNTS='/mnt/weaver/models /mnt/weaver/state'
DEPLOY_FILES="create-agent.sh retired-python.sh verify-load.sh agent_tuple.py turn.py decommission.sh"
WW_TEMPLATES="install/units/weaver-web-gate-con@.service.in install/units/weaver-web-admin-con@.service.in"
CONNECTORS_CMD="cargo build --locked --release --no-default-features --bin gate-con --bin admin-con"

section() { printf '\n== %s\n' "$*"; }
cuda_env() {
    export PATH=$CUDA_HOME/bin:$PATH
    export CUDA_PATH=$CUDA_HOME
}
# record KEY VALUE...: one line of the stamp, kept in BUILD until the seal assembles it.
record() {
    local k=$1; shift
    [[ "$k" =~ ^[a-z0-9][a-z0-9._@-]*$ ]] || { echo "record: bad key $k"; return 1; }
    printf '%s\n' "$*" | sudo tee "$BUILD/stamp.d/$k" >/dev/null || return 1
    printf 'stamp: %s = %s\n' "$k" "$*"
}
sha() { sha256sum "$1" | cut -d' ' -f1; }
# record_sha KEY FILE [BEFORE [AFTER]]: FILE's sha256 recorded as KEY's value, with BEFORE
# and AFTER around it where the value carries more. The digest is read before the record
# is made: inside record's own argument a failed sha is lost, and the record would be
# made without it.
record_sha() {
    local k=$1 f=$2 d
    d=$(sha "$f") && [[ "$d" =~ ^[0-9a-f]{64}$ ]] || { echo "record: no sha256 of $f for $k"; return 1; }
    record "$k" "${3:-}$d${4:-}"
}
# record_read KEY STATUS READ [MORE...]: READ, and MORE after it, recorded as KEY's value
# where STATUS, the exit status of the read that gave READ, is 0 and READ is not empty. A
# read that failed or gave nothing fails the step, for the reason record_sha gives.
record_read() {
    local k=$1 rc=$2; shift 2
    [ "$rc" = 0 ] && [ -n "${1:-}" ] || { echo "record: $k could not be read (status $rc)"; return 1; }
    record "$k" "$@"
}
used_bytes() { df -B1 --output=used / | tail -1 | tr -d ' '; }
# getent_absent DB NAME LABEL: nothing, and status 0, where getent finds no NAME in DB (its
# status 2). Otherwise a sentence naming LABEL, and status 1: NAME found (status 0), or a
# read that did not happen (any other status), which is not an absence.
getent_absent() {
    local g
    getent "$1" "$2" >/dev/null; g=$?
    case $g in
        2) return 0 ;;
        0) echo "$3 remains" ;;
        *) echo "getent exited $g, so whether $3 remains is not known" ;;
    esac
    return 1
}

# pin_check NAME VERSION: pacman reads NAME installed at VERSION. Otherwise a sentence, and
# status 1.
pin_check() {
    local v
    v=$(pacman -Q -- "$1" 2>/dev/null | awk '{print $2}')
    [ "$v" = "$2" ] || { echo "$1 is ${v:-not installed}, not $2"; return 1; }
}
# pacman_sources_check CONF MIRRORLIST: the package sources as pacman reads them: CONF names
# the core and extra repositories alone, each by an Include of MIRRORLIST and no Server line
# of its own, and MIRRORLIST names the archive's snapshot alone. Prints each finding.
pacman_sources_check() {
    local conf=$1 ml=$2 want
    want="Server = $ARCHIVE/\$repo/os/\$arch"
    awk -v ml="$ml" '
        /^[[:space:]]*(#|$)/ { next }
        /^\[.*\]$/ { s = substr($0, 2, length($0) - 2); if (s != "options") { repos[s] = 1; if (s != "core" && s != "extra") print "pacman.conf names the repository " s }; next }
        s != "options" && /^[[:space:]]*Server[[:space:]]*=/ { print "pacman.conf names a server of its own in [" s "]" }
        s != "options" && /^[[:space:]]*Include[[:space:]]*=/ { v = $0; sub(/^[^=]*=[[:space:]]*/, "", v); if (v != ml) print "[" s "] includes " v ", not " ml }
        END { if (!("core" in repos)) print "pacman.conf names no [core]"; if (!("extra" in repos)) print "pacman.conf names no [extra]" }
    ' "$conf"
    [ "$(grep -vE '^[[:space:]]*(#|$)' "$ml")" = "$want" ] || echo "$ml is not the archive's snapshot alone ($want)"
    return 0
}
# PACMAN_IGNORE: the packages pacman.conf holds back from any later upgrade, the kernel and
# the driver with their CUDA runtime: the hold release 1.0 made with apt-mark. Nothing
# updates after the seal; the hold is there for an operator who points pacman elsewhere.
PACMAN_IGNORE="linux nvidia-open nvidia-utils weaver-cuda-runtime"
# pacman_ignore CONF NAMES...: CONF's one IgnorePkg line made to name exactly NAMES, in
# place of the shipped commented line.
pacman_ignore() {
    local conf=$1; shift
    sudo sed -i -E '/^[[:space:]]*#?[[:space:]]*IgnorePkg[[:space:]]*=/d' "$conf" || return 1
    sudo sed -i -E "/^\[options\]\$/a IgnorePkg = $*" "$conf" || return 1
    ignored_check "$conf" "$@"
}
# ignored_check CONF NAMES...: CONF's IgnorePkg names each of NAMES, and IgnorePkg stands
# once. Prints each finding; exits 1 on any.
ignored_check() {
    local conf=$1 n line bad=""; shift
    n=$(grep -cE '^[[:space:]]*IgnorePkg[[:space:]]*=' "$conf")
    [ "$n" = 1 ] || bad+="pacman.conf has $n IgnorePkg lines, not one. "
    line=" $(grep -E '^[[:space:]]*IgnorePkg[[:space:]]*=' "$conf" | head -1 | sed -E 's/^[^=]*=//') "
    for n; do case $line in *" $n "*) ;; *) bad+="IgnorePkg does not name $n. " ;; esac; done
    [ -z "$bad" ] || { echo "$bad"; return 1; }
}
# one_kernel: one version-named tree under /usr/lib/modules, the running kernel's, from the
# pinned package; and /boot holding that kernel's image and initramfs alone, the image
# byte for byte the tree's vmlinuz (Arch's kernel image carries no version in its name).
one_kernel() {
    local n f bad=""
    n=$(find /usr/lib/modules -mindepth 1 -maxdepth 1 -type d -name '[0-9]*' | wc -l)
    [ "$n" = 1 ] && [ -d "/usr/lib/modules/$KVER" ] || bad+="more than one kernel, or not $KVER: $(ls /usr/lib/modules | tr '\n' ' '). "
    [ "$KVER" = "$PIN_KVER" ] || bad+="the running kernel is $KVER, not $PIN_KVER. "
    for f in $(sudo ls /boot 2>/dev/null); do
        case $f in vmlinuz-linux|initramfs-linux.img|grub) ;; *) bad+="/boot holds $f. " ;; esac
    done
    sudo cmp -s "/usr/lib/modules/$KVER/vmlinuz" /boot/vmlinuz-linux || bad+="/boot/vmlinuz-linux is not /usr/lib/modules/$KVER/vmlinuz. "
    [ -z "$bad" ] || { echo "$bad"; return 1; }
}
# kernel_pins: the kernel and the driver at their pins, and pacman.conf holding them back.
# Prints what is not.
kernel_pins() {
    pin_check linux "$PIN_LINUX"
    pin_check nvidia-open "$PIN_NVIDIA_OPEN"
    pin_check nvidia-utils "$PIN_NVIDIA_UTILS"
    # shellcheck disable=SC2086
    ignored_check /etc/pacman.conf $PACMAN_IGNORE
    return 0
}

facts() {
    section os; cat /etc/os-release
    section kernel; uname -a
    section cpu-memory-disk; nproc; free -g; df -h / /tmp
    section init; systemctl --version | head -1; stat -fc %T /sys/fs/cgroup
    section python; python3 --version
    section identity; cat /etc/machine-id
    section network; ip -4 -o addr show scope global; ip -4 route; resolvectl dns
    section hostguard; sudo nft list table inet hostguard
    section pacman; pacman -V | sed -n 's/^ *\(Pacman v.*\)/\1/p'; pacman -Q | wc -l
    sudo pacman-key --list-keys >/dev/null 2>&1 && echo "keyring: made at this guest's first boot (pacman-init)" || echo "keyring: NONE"
    section enabled-units; systemctl list-unit-files --state=enabled --no-legend --no-pager | awk '{print $1}' | tr '\n' ' '; echo
    section after-time-sync
    # The units that wait for a synchronized clock, where systemd-time-wait-sync holds
    # time-sync.target until one comes (the plan's boot waits, measured before any is cut).
    systemctl list-dependencies --reverse --plain --no-pager time-sync.target 2>/dev/null | tail -n +2 | sed 's/^[^a-z]*//' | tr '\n' ' '; echo
    section base-compilers-and-tools
    for t in cc gcc g++ make ld as git curl python3 sudo visudo setfacl runuser nvidia-smi; do
        printf '%-12s %s\n' "$t" "$(command -v "$t" || echo absent)"
    done
    # The base image's packages, before anything is installed: the cleanup removes what the
    # build added. Recorded once; a rerun keeps the first list.
    sudo install -d -o root -g root -m 0755 "$BUILD" "$BUILD/stamp.d" || return 1
    if [ ! -e "$BUILD/base-packages" ]; then
        pacman -Qq | sort | sudo tee "$BUILD/base-packages" >/dev/null || return 1
    fi
    section base-packages; wc -l <"$BUILD/base-packages"
    record base.image "${BASE_IMAGE:-unknown}" || return 1
    record base.snapshot "$ARCHIVE (the Arch Linux Archive's packages of that day)" || return 1
    # The image's version (the operator's decision 4 of 2026-11-15), as the host names it:
    # a release, since a respin never recompiles and this build compiles.
    [[ "${VERSION:-}" =~ ^[1-9][0-9]*\.0$ ]] || { echo "VERSION '${VERSION:-}' is not named as a release, <release>.0"; return 1; }
    record appliance.version "$VERSION" || return 1
    record os "$PRETTY_NAME" || return 1
    record kernel "$KVER" || return 1
    local v
    v=$(nproc); record_read build.vcpus $? "$v" || return 1
    v=$(awk '/^MemTotal:/{print int($2/1024)}' /proc/meminfo); record_read build.memory-mib $? "$v" || return 1
    v=$(id -un); record_read build.account $? "$v" "$HOME" || return 1
    v=$(used_bytes); record_read size.base-used-bytes $? "$v" || return 1
}

# The two OS reads the WeaverAgent seat asked of the base, now gates (the operator's ruling
# of 2026-11-16 moved 1.1 to Arch because Ubuntu 26.04 failed both): whether `test` run
# through sudo honours supplementary groups (uutils' did not), and whether visudo takes
# the connector rule's Defaults line (sudo-rs did not). Arch ships GNU coreutils and the
# original sudo, and both are expected to pass; the step fails where either does not. A
# throwaway account and file, removed in the same step, on any exit: a failure, an
# interrupt or a dropped session (HUP). /root's mode as found is kept in the build's
# records, so that a rerun after a cut-short run restores the first run's, and a rerun
# first removes whatever that run left.
OSP_U=weaver-probe OSP_G=weaver-probe-g OSP_F=/root/probe-0640 OSP_RULE=
os_probes_undo() {
    # PIPE as well: a dropped session without a terminal closes pipes rather than sending a
    # signal, and a child that wrote to one during the undo would die of SIGPIPE. Ignored
    # here, the children inherit it and get an error instead.
    trap '' INT TERM HUP PIPE
    sudo rm -f "$OSP_F"
    [ -z "$OSP_RULE" ] || rm -f "$OSP_RULE"
    [ ! -s "$BUILD/os-probes.root-mode" ] || sudo chmod "$(cat "$BUILD/os-probes.root-mode")" /root
    ! getent passwd "$OSP_U" >/dev/null || sudo userdel "$OSP_U"
    ! getent group "$OSP_G" >/dev/null || sudo groupdel "$OSP_G"
    trap - INT TERM HUP PIPE
}
os_probes() {
    local u=$OSP_U g=$OSP_G f=$OSP_F rule t s n
    [ -d "$BUILD" ] || { echo "no $BUILD; run facts first"; return 1; }
    [ -s "$BUILD/os-probes.root-mode" ] || stat -c %a /root | sudo tee "$BUILD/os-probes.root-mode" >/dev/null || return 1
    os_probes_undo
    trap os_probes_undo EXIT
    trap 'exit 129' HUP; trap 'exit 130' INT; trap 'exit 143' TERM
    sudo groupadd "$g" && sudo useradd --system --no-create-home --shell /usr/bin/nologin -G "$g" "$u" || return 1
    sudo touch "$f" && sudo chown "root:$g" "$f" && sudo chmod 0640 "$f" && sudo chmod 0711 /root
    section sudo-test-supplementary-group
    sudo -u "$u" test -r "$f"; t=$?
    echo "sudo -u $u test -r <root:$g 0640>: exit $t (GNU test: 0)"
    printf '/usr/bin/test is %s, owned by %s\n' "$(readlink -f /usr/bin/test)" "$(pacman -Qo /usr/bin/test 2>&1 | sed 's/.* is owned by //')"
    section nologin
    # The deploy scripts name /usr/sbin/nologin, which Arch reaches through its sbin link;
    # neither name is a login shell, so the accounts probe reads such an account as one
    # that cannot log in.
    n=$(readlink -f /usr/sbin/nologin)
    echo "/usr/sbin/nologin is $n; /etc/shells names it: $(grep -cxE '/usr/s?bin/nologin|/s?bin/nologin' /etc/shells)"
    section visudo-defaults-line
    rule=$(mktemp); OSP_RULE=$rule
    printf 'Defaults:%s !pam_session\n' "$u" >"$rule"
    sudo visudo -cf "$rule"; s=$?
    echo "visudo -cf: exit $s"
    printf 'sudo is %s, owned by %s\n' "$(readlink -f "$(command -v sudo)")" "$(pacman -Qo "$(command -v sudo)" 2>&1 | sed 's/.* is owned by //')"
    os_probes_undo; trap - EXIT HUP INT TERM
    getent_absent passwd "$u" "the probe account" || return 1
    getent_absent group "$g" "the probe group" || return 1
    sudo test -e "$f" && { echo "the probe file remains"; return 1; }
    echo "probe account, group and file removed; /root is $(stat -c %a /root) again"
    [ "$t" = 0 ] || { echo "REFUSED: test through sudo does not honour a supplementary group"; return 1; }
    [ "$s" = 0 ] || { echo "REFUSED: visudo does not take the connector rule's Defaults line"; return 1; }
    [ "$n" = /usr/bin/nologin ] && ! grep -qxE '/usr/s?bin/nologin|/s?bin/nologin' /etc/shells \
        || { echo "REFUSED: /usr/sbin/nologin is not /usr/bin/nologin, or /etc/shells names it"; return 1; }
}

# packages: pacman pointed at the archive's snapshot alone, the system brought to that day
# (-Syyuu, which also takes a package back where the image's is newer), then the build's
# packages. The kernel must read its pin after the update, and be the kernel running: an
# update that moved it would need a reboot this step does not make.
packages() {
    [ -s "$BUILD/base-packages" ] || { echo "no base package list; run facts first"; return 1; }
    printf 'Server = %s/$repo/os/$arch\n' "$ARCHIVE" | sudo tee /etc/pacman.d/mirrorlist >/dev/null || return 1
    local out
    out=$(pacman_sources_check /etc/pacman.conf /etc/pacman.d/mirrorlist)
    [ -z "$out" ] || { echo "$out"; return 1; }
    sudo pacman -Syyuu --noconfirm || return 1
    # shellcheck disable=SC2086
    sudo pacman -S --needed --noconfirm $PACKAGES || return 1
    pin_check linux "$PIN_LINUX" || return 1
    [ "$KVER" = "$PIN_KVER" ] || { echo "the running kernel is $KVER, not $PIN_KVER"; return 1; }
    section installed
    # shellcheck disable=SC2086
    pacman -Q $PACKAGES 2>&1
    command -v "g++-$CXX_MAJOR" >/dev/null || { echo "no g++-$CXX_MAJOR"; return 1; }
}

rustup_install() {
    curl -fsS --proto '=https' https://sh.rustup.rs -o /tmp/rustup-init.sh || return 1
    # Stamped, not pinned: sh.rustup.rs serves the current installer under one unversioned
    # name, which changes with each rustup release. It runs as the build account.
    record_sha build.rustup-init /tmp/rustup-init.sh 'sh.rustup.rs sha256 ' || return 1
    sh /tmp/rustup-init.sh -y --no-modify-path --profile minimal \
        --default-toolchain "$TOOLCHAIN" || return 1
    rm -f /tmp/rustup-init.sh
    rustup --version; rustc -vV; cargo -V
}

# The two trees, cloned from GitHub and checked out detached at the named commits. A tree
# that is not exactly its commit, clean, refuses: bootstrap marks a dirty tree -dirty and
# goes on, so the refusal is here.
trees() {
    [[ "${WA_COMMIT:-}" =~ ^[0-9a-f]{40}$ ]] || { echo "WA_COMMIT is not named in full"; return 1; }
    [[ "${WW_COMMIT:-}" =~ ^[0-9a-f]{40}$ ]] || { echo "WW_COMMIT is not named in full"; return 1; }
    [ ! -e "$WA" ] && [ ! -e "$WW" ] || { echo "a checkout already stands"; return 1; }
    git clone -q --no-checkout "$WA_URL" "$WA" && git -C "$WA" checkout -q --detach "$WA_COMMIT" || return 1
    git clone -q --no-checkout "$WW_URL" "$WW" && git -C "$WW" checkout -q --detach "$WW_COMMIT" || return 1
    local t c ch
    for t in "$WA:$WA_COMMIT" "$WW:$WW_COMMIT"; do
        c=${t#*:}; t=${t%%:*}
        section "$(basename "$t")"
        [ "$(git -C "$t" rev-parse HEAD)" = "$c" ] || { echo "$t is not at $c"; return 1; }
        [ -z "$(git -C "$t" status --porcelain=v1 --untracked-files=all)" ] || { echo "$t is not clean"; return 1; }
        ch=$(python3 -c 'import sys, tomllib; print(tomllib.load(open(sys.argv[1], "rb"))["toolchain"]["channel"])' "$t/rust-toolchain.toml")
        [ "$ch" = "$TOOLCHAIN" ] || { echo "$t pins $ch, not $TOOLCHAIN"; return 1; }
        git -C "$t" log -1 --format='%H %cI %s'
        echo "toolchain file: $ch"
    done
    record weaveragent.commit "$WA_COMMIT" || return 1
    record weaveragent.origin "$WA_URL" || return 1
    record weaverweb.commit "$WW_COMMIT" || return 1
    record weaverweb.origin "$WW_URL" || return 1
    local v
    v=$(rustc -vV | awk '/^release:/{r=$2} /^commit-hash:/{c=$2} /^host:/{h=$2} /^LLVM version:/{l=$3} END{print r, c, h, "LLVM", l}')
    record_read toolchain $? "$v" || return 1
}

# The CUDA toolkit, with no driver: the stack's build needs nvcc, not a module. CCCL 3.3.4
# goes first, from the archive's package store by digest and signature, so cuda's
# dependency on cccl is met by it and the day's 3.5.0 is never installed. Arch's cuda
# points its include/cccl at /usr/include/cccl, where the cccl package puts its headers.
toolkit() {
    local d v
    d=$(mktemp -d) || return 1
    curl -fsS --proto '=https' -o "$d/$CCCL_PKG" "$CCCL_URL" || return 1
    curl -fsS --proto '=https' -o "$d/$CCCL_PKG.sig" "$CCCL_URL.sig" || return 1
    [ "$(sha "$d/$CCCL_PKG")" = "$CCCL_SHA256" ] \
        || { echo "$CCCL_PKG is not the pinned file (sha256 $(sha "$d/$CCCL_PKG"))"; return 1; }
    sudo pacman-key --verify "$d/$CCCL_PKG.sig" "$d/$CCCL_PKG" 2>&1 || { echo "$CCCL_PKG's signature does not verify against the keyring"; return 1; }
    sudo pacman -U --needed --noconfirm "$d/$CCCL_PKG" || return 1
    rm -f -- "$d/$CCCL_PKG" "$d/$CCCL_PKG.sig"; rmdir -- "$d"
    sudo pacman -S --needed --noconfirm cuda || return 1
    pin_check cuda "$PIN_CUDA" || return 1
    pin_check cccl "$CCCL_PIN" || return 1
    section nvcc; "$CUDA_HOME/bin/nvcc" --version
    section cccl
    grep -h 'define CCCL_VERSION ' /usr/include/cccl/cuda/std/__cccl/version.h
    readlink "$CUDA_HOME/include/cccl"
    section driver-packages; pacman -Qq | grep -E '^(nvidia|libnvidia)' || echo "(none)"
    record cuda.toolkit "cuda $PIN_CUDA (Arch, from the snapshot)" || return 1
    v=$("$CUDA_HOME/bin/nvcc" --version | tail -1 | sed 's/^Build //'); record_read nvcc $? "$v" || return 1
    record cccl "cccl $CCCL_PIN, at /usr/include/cccl, which $CUDA_HOME/include/cccl names" || return 1
    record base.outside-snapshot "$CCCL_PKG from $CCCL_URL, sha256 $CCCL_SHA256, its signature checked; a build package, purged by the cleanup" || return 1
}

# stack_preconditions: the two settings the WeaverAgent test step needs (README, "Breaks"),
# read, never changed: unprivileged user namespaces with a uid map, and /bin/sh as bash (a
# gate test's stand-in is a /bin/sh script and allows bash's fd 255 only). Release 1.0 set
# both for the step and put them back (relaxed), since Ubuntu gives neither; Arch gives
# both. Prints what is not so; exits 1 on any.
stack_preconditions() {
    local bad="" o
    o=$(unshare --user --map-root-user id -u 2>&1)
    [ "$o" = 0 ] || bad+="an unprivileged user namespace with a uid map is not given ($o). "
    [ "$(readlink -f /bin/sh)" = /usr/bin/bash ] || bad+="/bin/sh is $(readlink -f /bin/sh), not bash. "
    [ -z "$bad" ] || { echo "$bad"; return 1; }
    echo "unprivileged user namespaces with a uid map: given; /bin/sh -> $(readlink /bin/sh) ($(readlink -f /bin/sh))"
}

# The agent stack, as its deploy script builds and installs it: bootstrap-stack.sh
# --install, unmodified, from the checkout. Memory in use is sampled every 5 s, as MemTotal
# less MemAvailable. Its output is kept as it streams, for the test count the stamp records
# (the tag's, decision 3 of 2026-11-15), and the status is bootstrap's own, never tee's.
stack_build() {
    [[ "$COMPUTE_CAP" =~ ^[0-9]{2,3}$ ]] || { echo "COMPUTE_CAP is not named (the compute capability without its dot, such as 86)"; return 1; }
    record build.compute-cap "$COMPUTE_CAP" || return 1
    cuda_env
    export NVCC_CCBIN=/usr/bin/g++-$CXX_MAJOR
    export CUDA_LIB_DIR=$CUDA_LIBS
    export CUDA_COMPUTE_CAP=$COMPUTE_CAP
    echo "CUDA_PATH=$CUDA_PATH NVCC_CCBIN=$NVCC_CCBIN CUDA_LIB_DIR=$CUDA_LIB_DIR CUDA_COMPUTE_CAP=$CUDA_COMPUTE_CAP"
    local v
    v=$("$NVCC_CCBIN" --version | head -1); record_read build.nvcc-host-compiler $? "$NVCC_CCBIN: $v" || return 1
    v=$(cc --version | head -1); record_read build.cc $? "$(readlink -f "$(command -v cc)"): $v" || return 1
    local rc=0 sampler
    ( while :; do awk '/^MemTotal:/{t=$2} /^MemAvailable:/{a=$2} END{print int((t-a)/1024)}' /proc/meminfo; sleep 5; done ) \
        >"$HOME/mem-samples" 2>/dev/null &
    sampler=$!
    (cd "$WA" && bash deploy/bootstrap-stack.sh --install) 2>&1 | tee "$HOME/stack-out"
    rc=${PIPESTATUS[0]}
    kill "$sampler" 2>/dev/null; wait "$sampler" 2>/dev/null
    printf 'memory: peak in use %s MiB of %s MiB (%s samples)\n' "$(sort -n "$HOME/mem-samples" | tail -1)" \
        "$(awk '/^MemTotal:/{print int($2/1024)}' /proc/meminfo)" "$(wc -l <"$HOME/mem-samples")"
    return "$rc"
}
# stack_tests OUT: bootstrap's test count from its output, "N passed, 0 failed", where its
# "== test" section holds one count line, N is not 0 and none failed. Otherwise a sentence,
# and status 1.
stack_tests() {
    local t
    t=$(awk '/^== / { s = $2 } s == "test" && /^   [0-9]+ passed, [0-9]+ failed$/ { print $1, $3; n++ }
        END { exit (n != 1) }' "$1" 2>/dev/null) \
        || { echo "bootstrap's output names no one test count in its test step ($1)"; return 1; }
    [ "${t#* }" = 0 ] && [ "${t% *}" != 0 ] || { echo "bootstrap's test step counted ${t% *} passed, ${t#* } failed"; return 1; }
    printf '%s passed, 0 failed\n' "${t% *}"
}
stack() {
    [ -d "$WA" ] || { echo "no checkout; run trees first"; return 1; }
    stack_preconditions || return 1
    stack_build || return 1
    local tuple=/etc/weaver/stack/install-tuple c
    section install-tuple; cat "$tuple"
    c=$(sed -n 's/^commit = //p' "$tuple")
    [ "$c" = "${WA_COMMIT:-}" ] || { echo "the tuple's commit is '$c', not $WA_COMMIT"; return 1; }
    record_sha stack.install-tuple "$tuple" '' " (as written at image build; see the build's note)" || return 1
    local f k v
    v=$(sort -n "$HOME/mem-samples" | tail -1); record_read stack.peak-memory-mib $? "$v" || return 1
    # The test count, as bootstrap's test step printed it: one count line in its "== test"
    # section, with no test failed. A clean run removes the step's own log, so its output
    # is the one record of the count.
    local tests
    tests=$(stack_tests "$HOME/stack-out") || { echo "$tests"; return 1; }
    record stack.tests "$tests (bootstrap-stack.sh's test step)" || return 1
    for f in /opt/weaver/bin/* /opt/weaver/lib/*; do
        [ -f "$f" ] && [ ! -L "$f" ] || continue
        # The key names the file under the prefix, its slash a dot (record refuses a slash).
        k=${f#/opt/weaver/}
        record_sha "stack.${k//\//.}" "$f" || return 1
    done
    # The deploy scripts an enrolled box runs (create-agent, verify-load and their
    # siblings), copied at the image's commit to a fixed root-owned path before the checkout
    # goes. verify-lifecycle.sh needs a buildable checkout and is not copied.
    sudo install -d -o root -g root -m 0755 "$DEPLOY_COPY" || return 1
    for f in $DEPLOY_FILES; do
        sudo install -o root -g root -m 0755 "$WA/deploy/$f" "$DEPLOY_COPY/$f" || return 1
        record_sha "deploy.$f" "$DEPLOY_COPY/$f" || return 1
    done
    rm -f "$HOME/mem-samples"
}

# The two connectors, built from the WeaverWeb checkout with no default features and
# installed root 0755. No unit is laid: the image half of WeaverWeb's staging is that
# seat's act. The stamp records the command and the two unrendered templates' digests.
connectors() {
    local t=$HOME/target/weaverweb f
    [ -d "$WW" ] || { echo "no checkout; run trees first"; return 1; }
    # shellcheck disable=SC2086
    (cd "$WW" && CARGO_TARGET_DIR=$t $CONNECTORS_CMD) || return 1
    sudo install -d -o root -g root -m 0755 /opt/weaver-web /opt/weaver-web/bin || return 1
    sudo install -o root -g root -m 0755 "$t/release/gate-con" "$t/release/admin-con" /opt/weaver-web/bin/ || return 1
    section installed; sha256sum /opt/weaver-web/bin/*
    record connectors.command "$CONNECTORS_CMD" || return 1
    record_sha connectors.gate-con /opt/weaver-web/bin/gate-con || return 1
    record_sha connectors.admin-con /opt/weaver-web/bin/admin-con || return 1
    for f in $WW_TEMPLATES; do record_sha "connectors.template.${f##*/}" "$WW/$f" '' ' (not laid)' || return 1; done
}

# The driver, by the Arch route (the Planner's ruling of 2026-11-16, route B's equivalent):
# Arch's nvidia-open, the open module prebuilt for the snapshot's one kernel, and
# nvidia-utils, its userspace at the module's version (libcuda, NVML, nvidia-smi,
# nvidia-modprobe, nvidia-persistenced). No DKMS, no kernel headers and no compiler touch
# the driver. Arch signs no module with a key a firmware trusts, so Secure Boot stays off.
# The step runs before the stack's: bootstrap's install refuses unless weaver-spu resolves
# libcuda.so.1, which the driver carries.
driver() {
    # One form for DRIVER, the same regex build-template.sh's inputs_ok checks.
    [[ "${DRIVER:-}" =~ ^[0-9]{3}\.[0-9]+(\.[0-9]+)?$ ]] || { echo "DRIVER is not named, or not a release such as 620.70.06"; return 1; }
    one_kernel || return 1
    case ${DRIVER_ROUTE:-} in
        arch-prebuilt) driver_arch_prebuilt ;;
        *) echo "DRIVER_ROUTE '${DRIVER_ROUTE:-}' is not a route this file builds (arch-prebuilt)"; return 1 ;;
    esac || return 1
    driver_check || return 1
}
driver_arch_prebuilt() {
    local p names="nvidia-open nvidia-utils" v repo
    [ "$DRIVER" = "$PIN_NVIDIA" ] || { echo "this file pins $PIN_NVIDIA, not $DRIVER"; return 1; }
    [ "$KVER" = "$PIN_KVER" ] || { echo "the module pin is for $PIN_KVER, not $KVER"; return 1; }
    # shellcheck disable=SC2086
    sudo pacman -S --needed --noconfirm $names || return 1
    pin_check nvidia-open "$PIN_NVIDIA_OPEN" || return 1
    pin_check nvidia-utils "$PIN_NVIDIA_UTILS" || return 1
    p=$(pacman -Qq | grep -E '^(dkms|linux(-[a-z]+)*-headers|nvidia(-open)?-dkms)$' || true)
    [ -z "$p" ] || { echo "installed, and not to be: $(tr '\n' ' ' <<<"$p")"; return 1; }
    section installed
    for p in $names; do
        repo=$(pacman -Si "$p" 2>/dev/null | awk -F': ' '/^Repository/{print $2; exit}')
        v=$(pacman -Q "$p" | awk '{print $2}'); record_read "driver.package.$p" $? "$v" "from $repo, $ARCHIVE" || return 1
    done
    printf '%s\n' $names | sudo tee "$BUILD/keep-driver" >/dev/null
    # The kernel and the driver held back from any later upgrade (the hold release 1.0 made
    # with apt-mark); the runtime package joins them at the cleanup.
    pacman_ignore /etc/pacman.conf linux nvidia-open nvidia-utils || return 1
    section held; grep -E '^IgnorePkg' /etc/pacman.conf
    record driver.route "arch-prebuilt (Arch's nvidia-open, prebuilt for linux $PIN_LINUX; nvidia-utils at its version; unsigned)" || return 1
    record driver.cuda-minimum "CUDA 13.4 needs an R615 or later driver (NVIDIA, CUDA 13.4.2 release notes, table 2); 13.x minor-version compatibility >= 580 (table 3); installed $DRIVER" || return 1
}
# driver_check: the module's preconditions to load, read with no card: present for the
# image's one kernel, modinfo's version and vermagic, its dependencies resolved, every
# firmware file it names present.
driver_check() {
    local m file ver vm fw bad=0 v n=0
    section module
    for m in nvidia nvidia-uvm nvidia-modeset; do
        file=$(modinfo -k "$KVER" -F filename "$m" 2>/dev/null) || { echo "modinfo finds no $m for $KVER"; bad=1; continue; }
        ver=$(modinfo -k "$KVER" -F version "$m")
        vm=$(modinfo -k "$KVER" -F vermagic "$m" | cut -d' ' -f1)
        printf '%s: %s version %s vermagic %s signer %s\n' "$m" "$file" "$ver" "$vm" "$(modinfo -k "$KVER" -F signer "$m" 2>/dev/null || echo none)"
        [ "$ver" = "$DRIVER" ] && [ "$vm" = "$KVER" ] || { echo "$m is not $DRIVER for $KVER"; bad=1; }
    done
    modprobe -S "$KVER" --show-depends nvidia || bad=1
    for fw in $(modinfo -k "$KVER" -F firmware nvidia); do
        if ls /lib/firmware/"$fw"* >/dev/null 2>&1; then echo "firmware: $fw present"; else echo "firmware: $fw MISSING"; bad=1; fi
    done
    [ "$bad" = 0 ] || return 1
    record driver.version "$DRIVER" || return 1
    v=$(modinfo -k "$KVER" -F vermagic nvidia); record_read driver.vermagic $? "$v" || return 1
    # The driver's own module directory, not the kernel's in-tree nvidiafb and its kin. A
    # list that comes back empty fails the step, since the files' digests are the record.
    for file in $(find "$(dirname "$(modinfo -k "$KVER" -F filename nvidia)")" -name '*.ko*' | sort); do
        record_sha "driver.module.${file##*/}" "$file" || return 1
        n=$((n + 1))
    done
    [ "$n" -gt 0 ] || { echo "no file of the driver's module directory was found to stamp"; return 1; }
    # modinfo prints nothing for a module with no signer, and that records as none. A
    # modinfo that fails is not an unsigned module.
    v=$(modinfo -k "$KVER" -F signer nvidia); record_read driver.signer $? "${v:-none}" || return 1
}

# The CUDA runtime the image keeps (the Planner's ruling of 2026-11-16, form b): Arch's cuda
# is one package, toolkit and runtime together, so the runtime is made into a package of
# its own inside this guest, from the toolkit's own files, unchanged: the libraries the
# installed members and engine load (RUNTIME_LIBS), each soname link to them, the
# /opt/cuda/lib64 link the loader's path names, and cuda's loader file. makepkg builds it as
# the build account under fakeroot, with nothing stripped. Each file's sha256 is taken from
# the toolkit before the build and read again from the installed package; the cleanup then
# removes cuda and installs this package in its place, so pacman owns every file the
# install tuple names. The PKGBUILD is code/guest/cuda-runtime/PKGBUILD, copied in by
# build-template.sh with this file.
RUNTIME_PKG=weaver-cuda-runtime
RUNTIME_LIBS="cudart cublas cublasLt curand nvrtc nvrtc-builtins"
RUNTIME_DIR=$BUILD/runtime
PKGBUILD_SRC=/usr/local/share/weaver-build/cuda-runtime/PKGBUILD
# runtime_list LIBDIR: the runtime package's files, one absolute path a line in C-locale
# order: each regular file in LIBDIR named lib<one of RUNTIME_LIBS>.so.<version>, each link
# in LIBDIR that resolves to one of them, the link LIBDIR's parent's lib64 where it names
# LIBDIR, and the loader file.
runtime_list() {
    local dir=$1 f l n
    {
        for n in $RUNTIME_LIBS; do
            find "$dir" -maxdepth 1 -type f -regextype posix-extended -regex ".*/lib${n}\.so\.[0-9.]+" | sort
        done >"$RUNTIME_DIR/real.tmp"
        cat "$RUNTIME_DIR/real.tmp"
        for l in "$dir"/*; do
            [ -L "$l" ] || continue
            grep -qxF -- "$(readlink -f "$l")" "$RUNTIME_DIR/real.tmp" && echo "$l"
        done
        f=$CUDA_HOME/lib64
        [ -L "$f" ] && [ "$(readlink -f "$f")" = "$(readlink -f "$dir")" ] && echo "$f"
        echo /etc/ld.so.conf.d/cuda.conf
    } | LC_ALL=C sort -u
    rm -f -- "$RUNTIME_DIR/real.tmp"
}
# runtime_resolved_check LIST LDD...: every CUDA library the loader resolved under
# CUDA_HOME for the files given (ldd's output, in the files LDD...) is in LIST, by its real
# path. Prints each one that is not.
runtime_resolved_check() {
    local list=$1 lib; shift
    for lib in $(cat "$@" | grep -oE "=> $CUDA_HOME/[^ ]+" | awk '{print $2}' | sort -u); do
        grep -qxF -- "$(readlink -f "$lib")" "$list" || echo "$lib ($(readlink -f "$lib")) resolves for the stack and is not in the runtime package"
    done
}
# runtime_hashes LIST OUT: "SHA256  PATH" for each regular file in LIST, and "LINK PATH ->
# TARGET" for each link, into OUT.
runtime_hashes() {
    local f
    while IFS= read -r f; do
        if [ -L "$f" ]; then printf 'LINK %s -> %s\n' "$f" "$(readlink "$f")"
        elif [ -f "$f" ]; then sha256sum -- "$f"
        else echo "MISSING $f"; fi
    done <"$1" >"$2"
}
# runtime_build: the runtime package made and its file list and hashes kept in RUNTIME_DIR,
# once: a rerun after cuda is gone finds them there.
runtime_build() {
    if [ -s "$RUNTIME_DIR/pkg.sha256" ] && sudo test -s "$RUNTIME_DIR/$(sudo cat "$RUNTIME_DIR/pkg.name" 2>/dev/null)"; then
        echo "kept from the first run: $(sudo cat "$RUNTIME_DIR/pkg.name")"; return 0
    fi
    pin_check cuda "$PIN_CUDA" || return 1
    local w ld f out v
    sudo install -d -o root -g root -m 0755 "$RUNTIME_DIR" || return 1
    w=$(mktemp -d) || return 1
    sudo chown "$(id -u):$(id -g)" "$RUNTIME_DIR"
    runtime_list "$CUDA_LIBS" >"$RUNTIME_DIR/files" || return 1
    for f in /opt/weaver/bin/* /opt/weaver/lib/*.so* /opt/weaver-web/bin/*; do
        [ -f "$f" ] && [ ! -L "$f" ] || continue
        env -u LD_LIBRARY_PATH LD_LIBRARY_PATH=/opt/weaver/lib ldd "$f" 2>/dev/null
    done >"$w/ldd"
    out=$(runtime_resolved_check "$RUNTIME_DIR/files" "$w/ldd")
    [ -z "$out" ] || { echo "$out"; return 1; }
    out=$(while IFS= read -r f; do pacman -Qoq -- "$f" 2>/dev/null | grep -qx cuda || echo "$f is not cuda's"; done <"$RUNTIME_DIR/files")
    [ -z "$out" ] || { echo "$out"; return 1; }
    runtime_hashes "$RUNTIME_DIR/files" "$RUNTIME_DIR/toolkit.hashes" || return 1
    ! grep -q '^MISSING ' "$RUNTIME_DIR/toolkit.hashes" || { grep '^MISSING ' "$RUNTIME_DIR/toolkit.hashes"; return 1; }
    v=${PIN_CUDA%-*}
    cp "$PKGBUILD_SRC" "$w/PKGBUILD" || return 1
    (cd "$w" && WEAVER_RUNTIME_LIST=$RUNTIME_DIR/files WEAVER_RUNTIME_VER=$v \
        PKGDEST="$w/out" SRCDEST="$w" BUILDDIR="$w/build" makepkg --noconfirm --nocheck 2>&1) || return 1
    f=$(ls "$w/out/$RUNTIME_PKG-$v-1-x86_64.pkg.tar.zst") || return 1
    # The package's own list, set against the file list: every file and link in it, and
    # nothing else but the directories that hold them.
    out=$(diff <(LC_ALL=C sort "$RUNTIME_DIR/files") \
               <(pacman -Qlpq "$f" | grep -v '/$' | sed 's|^|/|; s|//|/|' | LC_ALL=C sort))
    [ -z "$out" ] || { echo "the package's files are not the list:"; echo "$out"; return 1; }
    echo "$RUNTIME_PKG metadata, as makepkg wrote it: $(bsdtar -xOf "$f" .PKGINFO | grep -E '^(depend|provides|license) = ' | tr '\n' ' ')"
    sudo install -o root -g root -m 0644 "$f" "$RUNTIME_DIR/${f##*/}" || return 1
    printf '%s\n' "${f##*/}" | sudo tee "$RUNTIME_DIR/pkg.name" >/dev/null
    sha "$RUNTIME_DIR/${f##*/}" | sudo tee "$RUNTIME_DIR/pkg.sha256" >/dev/null
    sudo chown -R root:root "$RUNTIME_DIR"
    rm -rf -- "$w"
    echo "$RUNTIME_PKG: $(wc -l <"$RUNTIME_DIR/files") files and links, $(cat "$RUNTIME_DIR/pkg.sha256")"
}
# runtime_check: every file of the runtime package installed as the toolkit had it (each
# regular file's sha256, each link's target), and owned by the package. Prints each
# finding; exits 1 on any.
runtime_check() {
    local now f bad=""
    pin_check "$RUNTIME_PKG" "${PIN_CUDA%-*}-1" >/dev/null || bad+="$(pin_check "$RUNTIME_PKG" "${PIN_CUDA%-*}-1"). "
    now=$(mktemp) || return 1
    runtime_hashes "$RUNTIME_DIR/files" "$now"
    cmp -s "$RUNTIME_DIR/toolkit.hashes" "$now" || bad+="installed files differ from the toolkit's: $(diff "$RUNTIME_DIR/toolkit.hashes" "$now" | grep '^[<>]' | head -4 | tr '\n' ' '). "
    rm -f -- "$now"
    while IFS= read -r f; do
        [ "$(pacman -Qoq -- "$f" 2>/dev/null)" = "$RUNTIME_PKG" ] || bad+="$f is not $RUNTIME_PKG's. "
    done <"$RUNTIME_DIR/files"
    [ -z "$bad" ] || { echo "$bad"; return 1; }
}

# tuple_runtime_check TUPLE: each CUDA runtime file the install tuple names (runtime.<name>
# = <sha256> <path>) owned by the runtime package and of that digest. Prints each finding.
tuple_runtime_check() {
    local k d f n=0
    while read -r k _ d f; do
        n=$((n + 1))
        [ -f "$f" ] || { echo "$k names $f, which is not a file"; continue; }
        [ "$(pacman -Qoq -- "$f" 2>/dev/null)" = "$RUNTIME_PKG" ] || echo "$k: $f is not $RUNTIME_PKG's"
        [ "$(sha "$f")" = "$d" ] || echo "$k: $f is not the digest the tuple names"
    done < <(grep -E '^runtime\.[a-z]+ = ' "$1" 2>/dev/null)
    [ "$n" -gt 0 ] || echo "$1 names no runtime file"
    return 0
}

# The runtime set the cleanup keeps, as explicitly installed (everything else the build
# added is marked a dependency, and removed once nothing kept needs it): the CUDA runtime
# package, the driver's packages (the route's list), acl (decommission's setfacl), the C++
# runtime the members load (gcc-libs: libstdc++ and libgcc_s), python (the deploy scripts;
# create-agent.sh needs 3.11 or later), and util-linux (runuser, root's drops to accounts).
KEEP="$RUNTIME_PKG acl gcc-libs python util-linux"
# BUILD_RE: a build package, by name. The cleanup removes every installed package it
# matches, base or added, and the probe refuses the seal on any left.
BUILD_RE='^(base-devel|gcc|gcc[0-9]+|clang|llvm|lld|compiler-rt|cmake|make|autoconf|automake|bison|flex|libtool|m4|patch|pkgconf|binutils|fakeroot|debugedit|dkms|linux(-[a-z]+)*-headers|nvidia(-open)?-dkms|cuda|cuda-tools|cccl|nsight-.*|git|rust|rustup|cargo|meson|ninja|go|gdb)$'
# Base-image packages the cleanup also removes by name: cloud-init, removed outright once
# the build seed is used (the Planner's ruling of 2026-11-16, the stronger form of the
# operator's "off"), and growpart, which only cloud-init runs. Every other base package is
# marked explicitly installed first, so it stays; the simulation refuses a base package
# that would go and is not named here or matched by BUILD_RE.
PURGE_BASE="cloud-init cloud-guest-utils"
CLOUD_INIT_UNITS="cloud-init-local.service cloud-init-main.service cloud-init-network.service
  cloud-config.service cloud-final.service"
# unit_links_check: no link under /etc/systemd that leads nowhere: an enablement whose unit
# is gone. A mask leads to /dev/null, which stands. Prints each.
unit_links_check() {
    sudo find /etc/systemd -xdev -xtype l -printf '%p -> %l (leads nowhere)\n' 2>/dev/null
    return 0
}
# The image's base inbound policy (the operator's decision 9 of 2026-11-15): its own boot
# rules drop inbound and accept SSH. One table of the image's own, which nftables.service
# loads from /etc/nftables.conf before the network comes up, in place of Arch's shipped
# file. The file never flushes the ruleset and names its own table alone, so loading it
# again replaces that table and nothing else. Arch's unit (nftables 1.1.7) is a oneshot
# with no stop command and no RemainAfterExit, so nothing removes the table at a stop, and
# no stop command may be added: on such a unit systemd runs ExecStop as soon as the start
# exits. Release 1.0's drop-in, which made Ubuntu's stop remove this table alone, is not
# carried, and firewall_check reads the unit with no stop command. Accepted: loopback,
# replies (established and related), the ICMPv6 neighbour-discovery types IPv6 cannot work
# without, and TCP 22. Outbound is not limited. Admin's table is separate and admin's: a
# drop here is final, so an accept in it cannot open a port through this table
# (weaver-appliance-build-Spec section 3).
FIREWALL_TABLE="inet weaver_appliance"
FIREWALL_RULES='#!/usr/bin/nft -f
# The appliance image'"'"'s base inbound policy (weaver-appliance-build-Spec): inbound is
# dropped but loopback, replies, IPv6 neighbour discovery and SSH. Outbound is not limited.
# This file names its own table alone and never flushes the ruleset.
destroy table inet weaver_appliance
table inet weaver_appliance {
	chain input {
		type filter hook input priority filter; policy drop;
		iif "lo" accept
		ct state established,related accept
		icmpv6 type { nd-neighbor-solicit, nd-neighbor-advert, nd-router-advert } accept
		tcp dport 22 accept
	}
}'
# The image's SSH settings (the operator's ruling of 2026-11-16: root, set at first login):
# no password of any kind and no empty one, and root by key alone. sshd keeps the first
# value it reads for each keyword, and Arch's sshd_config includes sshd_config.d's files,
# in name order, before its own settings, so this file, first by name, decides all four.
SSHD_DROPIN=/etc/ssh/sshd_config.d/10-weaver-appliance.conf
SSHD_SETTINGS='# The appliance image'"'"'s SSH settings (weaver-appliance-build-Spec): keys alone.
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitEmptyPasswords no
PermitRootLogin prohibit-password'
# The units that would update the image or its keys from the network, masked: the
# keyring's weekly sync, systemd-sysupdate, and pacman-init, which would make a pacman
# master key, a private key, at every box's first boot (its file is the image builder's,
# under /etc, and is removed besides).
UPDATE_UNITS="archlinux-keyring-wkd-sync.timer archlinux-keyring-wkd-sync.service
  systemd-sysupdate.timer systemd-sysupdate.service systemd-sysupdate-reboot.timer
  systemd-sysupdate-reboot.service systemd-sysupdate-update.timer
  systemd-sysupdate-update.service systemd-sysupdate-auto-enable.service pacman-init.service"
# systemd 262's cloud metadata service. Its generator pulls these units in where the
# machine's DMI identity names one of the cloud vendors udev's hwdb lists (40-imds.hwdb:
# EC2, Azure, GCE, Hetzner, Oracle, Scaleway, Tencent, Alibaba, Vultr) or the kernel line
# names systemd.imds; the service then reads metadata over the network, a trust case the
# hypervisor's does not cover. Not shown inert (an operator's hypervisor or cloud can
# present such an identity), so masked, the generator with them (the Planner's ruling of
# 2026-11-16).
IMDS_UNITS="systemd-imds-early-network.service systemd-imds-import.service systemd-imdsd.socket
  systemd-imdsd@.service systemd-imds-metrics.socket systemd-imds-metrics@.service"
IMDS_GENERATOR=systemd-imds-generator
# resolved as release 1.0 had it, where Arch's compiled defaults differ (its shipped
# resolved.conf lists them): no fallback resolver (Arch's lists Quad9, Cloudflare and
# Google), so the image names none until the operator's network does; and no LLMNR or
# multicast DNS, both on in Arch's build, where LLMNR listens on port 5355 of every address
# and the image's listeners beyond loopback are SSH alone (ruling 4).
RESOLVED_DROPIN=/etc/systemd/resolved.conf.d/10-weaver-appliance.conf
RESOLVED_SETTINGS='# The appliance image names no resolver (weaver-appliance-build-Spec); the
# operator'"'"'s network does. The empty value turns off the compiled fallback list. No
# LLMNR and no multicast DNS: nothing but SSH listens beyond loopback.
[Resolve]
FallbackDNS=
LLMNR=no
MulticastDNS=no'
# The EFI system partition, mounted where the MANIFEST reads it: the cloud image installs
# GRUB's EFI loader there (--efi-directory=/efi --removable) and leaves the partition out
# of fstab, so without this line the image's identity would not cover its loader.
ESP_DIR=/efi
ESP_TYPE=c12a7328-f81f-11d2-ba4b-00a0c93ec93b
# The swap file the cloud image ships, removed (the Planner's ruling of 2026-11-16): its
# subvolume, its fstab line.
SWAP_SUBVOL=/swap

# removal_judge SIM KEEP BASE PURGE: a simulated removal (SIM, the names pacman would remove,
# one a line) judged: no name of KEEP removed, and no name of BASE (the base image's
# packages, one a line) removed but those in PURGE (one a line). Prints each finding;
# exits 1 on any. Fixed strings throughout: a name such as gcc-libs means itself.
removal_judge() {
    local sim=$1 keep=$2 base=$3 purge=$4 bad="" p
    for p in $(cat "$keep"); do grep -qxF -- "$p" "$sim" && bad+="the simulation would remove $p, which is kept. "; done
    p=$(grep -xF -f "$base" "$sim" | grep -vxF -f "$purge" || true)
    [ -z "$p" ] || bad+="the simulation would remove base packages not named: $(tr '\n' ' ' <<<"$p"). "
    [ -z "$bad" ] || { echo "$bad"; return 1; }
}
# remove_judged NAME...: NAME removed with what only it held (pacman -Rns), after a
# simulation of the same call judged by removal_judge.
remove_judged() {
    local w rc=0
    w=$(mktemp -d) || return 1
    printf '%s\n' $KEEP $(cat "$BUILD/keep-driver") >"$w/keep"
    printf '%s\n' "$@" >"$w/purge"
    sudo pacman -Rns --print --print-format '%n' --noconfirm "$@" >"$w/sim" 2>"$w/sim.err" \
        || { echo "the simulated removal refuses:"; cat "$w/sim.err"; rm -rf -- "$w"; return 1; }
    removal_judge "$w/sim" "$w/keep" "$BUILD/base-packages" "$w/purge" || { rm -rf -- "$w"; return 1; }
    echo "simulation: $(wc -l <"$w/sim") packages to remove, none of the runtime set, no base package but those named or matched"
    sudo pacman -Rns --noconfirm "$@" >"$w/rm.log" 2>&1 || rc=$?
    [ "$rc" = 0 ] || tail -30 "$w/rm.log"
    echo "removed: $(grep -cE '^\([0-9]+/[0-9]+\) removing ' "$w/rm.log" || true) packages"
    rm -rf -- "$w"
    return "$rc"
}

# cleanup: the checked list. Each removal here is judged by `probes`, which the seal runs
# again before it writes anything.
cleanup() {
    [ -s "$BUILD/keep-driver" ] || { echo "the driver step has not passed; the cleanup keeps its packages"; return 1; }
    local before p added purge installed n brc
    before=$(used_bytes); brc=$?
    section before; df -h /
    du -sh "$WA" "$WW" "$HOME/target" "$HOME/.cargo" "$HOME/.rustup" "$CUDA_HOME" 2>/dev/null
    # A rerun keeps the first run's figure: the size before any cleanup.
    if [ -s "$BUILD/stamp.d/size.before-cleanup-used-bytes" ]; then
        echo "kept from the first run: size.before-cleanup-used-bytes = $(cat "$BUILD/stamp.d/size.before-cleanup-used-bytes")"
    else
        record_read size.before-cleanup-used-bytes "$brc" "$before" || return 1
    fi

    section "1. the CUDA runtime made into a package of its own, from the toolkit's files"
    runtime_build || return 1

    section "2-3. the source trees, their build directories, the Rust toolchain and cargo's caches"
    rm -rf -- "$WA" "$WW" "$HOME/target" "$HOME/.cargo" "$HOME/.rustup" "$HOME/.cache" || return 1
    sudo rm -rf -- /root/.cargo /root/.rustup /root/.cache || return 1

    section "4-5. the compilers, build tools, the CUDA toolkit, and cloud-init"
    installed=$(pacman -Qq | sort) || return 1
    added=$(comm -13 "$BUILD/base-packages" <(printf '%s\n' "$installed"))
    # Every base package still installed is marked explicitly installed, so a removal's
    # recursion reaches only what the build added; what the build added is marked a
    # dependency but the runtime set, which is explicit. Only installed names are marked:
    # a rerun finds what the first run removed gone.
    # shellcheck disable=SC2046
    sudo pacman -D --asexplicit --noconfirm $(comm -12 "$BUILD/base-packages" <(printf '%s\n' "$installed") | grep -vxF -f <(printf '%s\n' $PURGE_BASE)) >/dev/null || return 1
    # shellcheck disable=SC2086
    [ -z "$added" ] || sudo pacman -D --asdeps --noconfirm $added >/dev/null || return 1
    # shellcheck disable=SC2046
    sudo pacman -D --asexplicit --noconfirm $(printf '%s\n' $KEEP $(cat "$BUILD/keep-driver") | grep -xF -f <(printf '%s\n' "$installed")) >/dev/null || return 1
    # Removed by name: PURGE_BASE and every installed package BUILD_RE matches, less the
    # runtime set, and what only they held (pacman -Rns).
    # shellcheck disable=SC2046
    purge=$( { printf '%s\n' $PURGE_BASE; printf '%s\n' "$installed" | grep -E "$BUILD_RE"; } |
             grep -xF -f <(printf '%s\n' "$installed") | sort -u | grep -vxF -f <(printf '%s\n' $KEEP $(cat "$BUILD/keep-driver")) || true)
    # cloud-init's units, enabled by the image's builder, are disabled first: their links
    # are no package's, and would stand with nothing behind them once the package goes.
    if pacman -Q cloud-init >/dev/null 2>&1; then
        sudo systemctl disable $CLOUD_INIT_UNITS 2>&1 || return 1
    fi
    echo "removed by name: $(tr '\n' ' ' <<<"${purge:-none}")"
    if [ -n "$purge" ]; then
        # shellcheck disable=SC2086
        remove_judged $purge || return 1
    fi
    # Then what the build added that nothing kept needs (installed as a dependency and
    # required by nothing), until none is left; the same judge each round.
    for n in 1 2 3 4 5 6; do
        p=$(pacman -Qdtq 2>/dev/null || true)
        [ -n "$p" ] || break
        echo "round $n, no longer needed: $(tr '\n' ' ' <<<"$p")"
        # shellcheck disable=SC2086
        remove_judged $p || return 1
    done
    [ -z "$(pacman -Qdtq 2>/dev/null)" ] || { echo "packages no longer needed remain after six rounds: $(pacman -Qdtq | tr '\n' ' ')"; return 1; }
    sudo rm -rf -- /var/lib/dkms /usr/src/nvidia-* "$CUDA_HOME/include" "$CUDA_HOME/bin"
    # cloud-init's leftovers that no package owns: the network file it wrote for the build
    # guest (the running guest keeps its address; networkd reads the file only at a
    # start), and the empty directory of its units' links.
    sudo rm -f /etc/systemd/network/10-cloud-init-*.network || return 1
    sudo rmdir /etc/systemd/system/cloud-init.target.wants 2>/dev/null || true
    p=$(unit_links_check)
    [ -z "$p" ] || { echo "$p"; return 1; }

    section "the CUDA runtime package in the toolkit's place"
    if ! pacman -Q "$RUNTIME_PKG" >/dev/null 2>&1; then
        sudo pacman -U --noconfirm "$RUNTIME_DIR/$(cat "$RUNTIME_DIR/pkg.name")" || return 1
    fi
    runtime_check || return 1
    # shellcheck disable=SC2086
    pacman_ignore /etc/pacman.conf $PACMAN_IGNORE || return 1
    echo "$RUNTIME_PKG installed: every file the toolkit's, owned by the package; held with the kernel and driver"
    section kept; pacman -Q $KEEP $(cat "$BUILD/keep-driver") 2>&1

    section "the loader, after the removals"
    sudo ldconfig || return 1
    loader_check || return 1

    section "the swap file removed"
    if [ -e "$SWAP_SUBVOL" ]; then
        sudo swapoff -a 2>&1
        sudo btrfs subvolume delete "$SWAP_SUBVOL" 2>&1 || return 1
    fi
    sudo sed -i -E '\|^[^#]*[[:space:]]swap[[:space:]]|d' /etc/fstab || return 1
    swap_check || return 1
    echo "no swap: $SWAP_SUBVOL gone, no swap line in /etc/fstab"

    section "the EFI system partition at $ESP_DIR"
    esp_mount || return 1
    esp_check || return 1

    section "the initramfs: no kms hook, so no nouveau"
    # Arch's NVIDIA instructions: without the kms hook the initramfs carries no nouveau,
    # which nvidia-utils also blacklists; the module loads from the root filesystem.
    sudo sed -i -E '/^HOOKS=/ s/[[:space:]]kms([[:space:]])/\1/' /etc/mkinitcpio.conf || return 1
    grep -E '^HOOKS=' /etc/mkinitcpio.conf
    sudo mkinitcpio -P >"$HOME/mkinitcpio.log" 2>&1 || { tail -20 "$HOME/mkinitcpio.log"; return 1; }
    rm -f -- "$HOME/mkinitcpio.log"
    initrd_check || return 1
    echo "initramfs $(sudo sha256sum /boot/initramfs-linux.img | cut -c1-16): no networkd, no nouveau"

    section "the base inbound policy: drop, but SSH"
    printf '%s\n' "$FIREWALL_RULES" | sudo tee /etc/nftables.conf >/dev/null || return 1
    # Enabled for the next boot, not loaded now: the build guest keeps its own network.
    sudo systemctl enable nftables.service 2>&1 || return 1
    firewall_check || return 1
    echo "nftables.service enabled with the image's table"

    section "SSH: keys alone"
    # Written now, read at the next boot: the build account logs in by key, and none of the
    # four settings bears on that.
    printf '%s\n' "$SSHD_SETTINGS" | sudo tee "$SSHD_DROPIN" >/dev/null || return 1
    sudo chmod 0644 "$SSHD_DROPIN" || return 1
    sudo sshd -t 2>&1 || return 1
    sshd_check || return 1
    echo "$SSHD_DROPIN: as sshd reads it for root, no password, no empty password, root by key alone"

    section "no resolver of the image's own"
    sudo install -d -m 0755 "${RESOLVED_DROPIN%/*}" || return 1
    printf '%s\n' "$RESOLVED_SETTINGS" | sudo tee "$RESOLVED_DROPIN" >/dev/null || return 1
    resolved_check || return 1
    echo "$RESOLVED_DROPIN: FallbackDNS empty, LLMNR and multicast DNS off"

    section "the data mount points"
    # shellcheck disable=SC2086
    sudo install -d -o root -g root -m 0755 /mnt/weaver $DATA_MOUNTS || return 1
    mounts_check || return 1
    echo "$DATA_MOUNTS: empty, root's, mode 0755, on the image's root"

    section "the image's hostname"
    # The image's own hostname, in place of the build guest's, written here so that every
    # probes pass the recipe reaches (its own probes step, then the seal's) reads it. The
    # file alone: the running guest keeps its name, which the probes read as the build
    # guest's.
    printf '%s\n' "$IMAGE_HOSTNAME" | sudo tee /etc/hostname >/dev/null || return 1
    echo "/etc/hostname: $(cat /etc/hostname) (the build guest runs as $(hostname))"

    section "updates and the cloud metadata service masked, sources on the snapshot"
    # pacman-init's file is the image builder's, under /etc, where a mask goes: it is
    # removed with its link first.
    sudo rm -f /etc/systemd/system/pacman-init.service /etc/systemd/system/multi-user.target.wants/pacman-init.service || return 1
    # shellcheck disable=SC2086
    sudo systemctl mask $UPDATE_UNITS $IMDS_UNITS >/dev/null || return 1
    sudo install -d -m 0755 /etc/systemd/system-generators || return 1
    sudo ln -sfn /dev/null "/etc/systemd/system-generators/$IMDS_GENERATOR" || return 1
    sudo systemctl daemon-reload
    imds_check || return 1
    updates_check || return 1
    p=$(pacman_sources_check /etc/pacman.conf /etc/pacman.d/mirrorlist)
    [ -z "$p" ] || { echo "$p"; return 1; }
    sudo pacman -Scc --noconfirm >/dev/null 2>&1
    sudo rm -rf /var/cache/pacman/pkg/* /var/lib/pacman/sync/* /tmp/* /var/tmp/* 2>/dev/null
    echo "update units and the metadata service masked; pacman names the snapshot alone; caches and sync databases gone"

    section after; df -h /
    local v
    v=$(used_bytes); record_read size.after-cleanup-used-bytes $? "$v" || return 1
    sudo fstrim -v /
}

# loader_check: bootstrap's own check after ldconfig (no LD_LIBRARY_PATH but the prefix's
# lib): no library "not found" for any member, engine library or connector, the engine
# from /opt/weaver/lib, and each CUDA or driver library resolved to a package kept.
loader_check() {
    local f out bad=0 lib real owner
    for f in /opt/weaver/bin/* /opt/weaver/lib/*.so* /opt/weaver-web/bin/*; do
        [ -f "$f" ] && [ ! -L "$f" ] || continue
        out=$(env -u LD_LIBRARY_PATH LD_LIBRARY_PATH=/opt/weaver/lib ldd "$f" 2>&1)
        if grep -q 'not a dynamic executable' <<<"$out"; then
            # busybox is static; the applet list is text.
            case ${f##*/} in busybox|busybox.applets) continue ;; *) echo "$f is not dynamic"; bad=1; continue ;; esac
        fi
        if grep -q 'not found' <<<"$out"; then echo "$f:"; grep 'not found' <<<"$out"; bad=1; fi
    done
    out=$(env -u LD_LIBRARY_PATH LD_LIBRARY_PATH=/opt/weaver/lib ldd /opt/weaver/bin/weaver-spu /opt/weaver/lib/libggml-cuda.so.0 2>&1)
    grep -E '^[[:space:]]*lib(ggml|llama)' <<<"$out" | grep -v '=> /opt/weaver/lib/' && bad=1
    for lib in $(grep -oE '=> /[^ ]*lib(cudart|cublas|cublasLt|curand|cuda)\.so[^ ]*' <<<"$out" | awk '{print $2}' | sort -u); do
        real=$(readlink -f "$lib"); owner=$(pacman -Qoq -- "$real" 2>/dev/null)
        printf '%s -> %s (%s) %s\n' "$lib" "$real" "${owner:-no package}" "$(sha "$real" | cut -c1-16)"
        [ -n "$owner" ] || bad=1
    done
    [ "$bad" = 0 ] && echo "loader: every library resolves; the engine from /opt/weaver/lib"
    return "$bad"
}

# initrd_check: the running kernel's initramfs holds no networkd and no nouveau. Prints what
# it finds; exits 1 on any, or where the initramfs cannot be listed.
initrd_check() {
    local list found
    list=$(sudo lsinitcpio /boot/initramfs-linux.img 2>/dev/null) && [ -n "$list" ] \
        || { echo "lsinitcpio cannot read /boot/initramfs-linux.img"; return 1; }
    found=$(grep -E '(systemd-networkd|/nouveau\.ko|/nouveau/)' <<<"$list" | sort -u | head -8)
    [ -z "$found" ] || { echo "$found"; return 1; }
}

# firewall_check: the base inbound policy as the next boot loads it: /etc/nftables.conf
# exactly as FIREWALL_RULES holds it, accepted by nft's check, nftables.service enabled,
# and the unit, drop-ins and all, with no stop command. Prints each difference; exits 1 on
# any.
firewall_check() {
    local bad="" s
    cmp -s <(printf '%s\n' "$FIREWALL_RULES") /etc/nftables.conf || bad+="/etc/nftables.conf is not the image's rules. "
    s=$(systemctl cat nftables.service 2>/dev/null | grep -E '^[[:space:]]*(ExecStop|ExecStopPost|RemainAfterExit)=' | tr '\n' ' ')
    [ -z "$s" ] || bad+="nftables.service carries $s. "
    grep -q '^ExecStart=/usr/bin/nft -f /etc/nftables.conf$' <<<"$(systemctl cat nftables.service 2>/dev/null)" || bad+="nftables.service does not load /etc/nftables.conf. "
    sudo nft -c -f /etc/nftables.conf >/dev/null 2>&1 || bad+="nft's check refuses /etc/nftables.conf. "
    [ "$(systemctl is-enabled nftables.service 2>/dev/null)" = enabled ] || bad+="nftables.service is not enabled. "
    [ -z "$bad" ] || { echo "$bad"; return 1; }
}
# sshd_check: the image's SSH settings as sshd reads them: SSHD_DROPIN exactly as
# SSHD_SETTINGS holds it, and sshd's merged configuration for root naming each of the
# four, whatever the case of its keywords (OpenSSH 10.2 prints them in lower case, 10.6 as
# written). sshd -T exits at once where it can load no host key, and the seal removes the
# host keys, so it is given a throwaway key under /run, which the key probes do not scan,
# and the key goes after. Prints each difference; exits 1 on any.
sshd_check() {
    local bad="" d t k
    cmp -s <(printf '%s\n' "$SSHD_SETTINGS") "$SSHD_DROPIN" || bad+="$SSHD_DROPIN is not the image's settings. "
    if d=$(sudo mktemp -d /run/weaver-sshd-check.XXXXXX); then
        if sudo ssh-keygen -q -t ed25519 -N '' -C sshd-check -f "$d/k" </dev/null >/dev/null 2>&1 \
            && t=$(sudo sshd -T -o HostKey="$d/k" -C user=root,host=localhost,addr=127.0.0.1 2>&1); then
            for k in "passwordauthentication no" "kbdinteractiveauthentication no" \
                     "permitemptypasswords no" "permitrootlogin prohibit-password"; do
                grep -qixF "$k" <<<"$t" || bad+="sshd -T reads '$(grep -im1 "^${k%% *} " <<<"$t" || echo "no ${k%% *}")', not '$k'. "
            done
        else
            bad+="sshd -T did not run ($(tail -1 <<<"${t:-no output}")) "
        fi
        sudo rm -f -- "$d/k" "$d/k.pub"; sudo rmdir -- "$d"
    else
        bad+="no scratch directory under /run for sshd -T. "
    fi
    [ -z "$bad" ] || { echo "$bad"; return 1; }
}
# accounts_judge MODE PASSWD SHADOW GSHADOW SHELLS BACKUP...: who can log in, from the
# account files given. MODE final is the sealed image: root's password field empty and its
# last change 0, so login asks for no password and requires a new one at once (the
# operator's ruling of 2026-11-16), and root's shell a login shell. In both modes: every
# password in the shadow file (field 2 of passwd is x), no account but root with a login
# shell (one SHELLS lists), every account but root locked (its field begins ! or *), and no
# password hash ($) in SHADOW, GSHADOW or any BACKUP (the tools' shadow- and gshadow-
# copies). MODE pre, before the seal, leaves out the build account op, which the seal
# removes, and root's two fields, which the seal sets. Prints each finding.
accounts_judge() {
    local mode=$1 passwd=$2 shadow=$3 gshadow=$4 shells=$5 f b=(); shift 5
    # A backup the tools have not written is not a finding.
    for f; do [ -e "$f" ] && b+=("$f"); done
    awk -F: -v mode="$mode" '
        FILENAME == ARGV[1] { if ($0 !~ /^[[:space:]]*(#|$)/) sh[$0] = 1; next }
        FILENAME == ARGV[2] {
            if (mode == "pre" && $1 == "op") next
            if ($2 != "x") print $1 ": the password field of passwd is not x"
            if ($1 == "root") { if (!($7 in sh)) print "root: the shell " $7 " is not a login shell"; next }
            if ($7 in sh) print $1 ": the login shell " $7
            next
        }
        FILENAME == ARGV[3] {
            if (mode == "pre" && $1 == "op") next
            if ($2 ~ /\$/) print $1 ": a password hash in " FILENAME
            if ($1 == "root") {
                if (mode == "final" && ($2 != "" || $3 != "0"))
                    print "root: the password field is " ($2 == "" ? "empty" : "not empty") " and the last change " ($3 == "" ? "unset" : $3) ", not empty and 0"
                next
            }
            if ($2 !~ /^[!*]/) print $1 ": not locked"
            next
        }
        { if ($2 ~ /\$/) print $1 ": a password hash in " FILENAME }
    ' "$shells" "$passwd" "$shadow" "$gshadow" "${b[@]}"
}

# firstboot_paths_check: systemd's first-boot paths as Arch's systemd 262 ships them, present
# and not masked (the operator's ruling of 2026-11-16: leave and name them), with the
# network generator, through which the proof hands the guest its network (the Planner's
# ruling of 2026-11-16). What an operator feeds through them is the operator's. Prints each
# finding.
firstboot_paths_check() {
    local u s
    grep -q 'ssh\.authorized_keys\.root' /usr/lib/tmpfiles.d/provision.conf 2>/dev/null \
        || echo "/usr/lib/tmpfiles.d/provision.conf does not name ssh.authorized_keys.root"
    [ -e /etc/tmpfiles.d/provision.conf ] || [ -L /etc/tmpfiles.d/provision.conf ] \
        && echo "/etc/tmpfiles.d/provision.conf stands over the shipped file"
    for u in systemd-firstboot.service systemd-creds.socket systemd-network-generator.service; do
        s=$(systemctl is-enabled "$u" 2>/dev/null)
        case $s in ""|masked*) echo "$u is ${s:-not found}" ;; esac
    done
    s=$(systemctl is-enabled systemd-network-generator.service 2>/dev/null)
    case $s in enabled|""|masked*) ;; *) echo "systemd-network-generator.service is $s, not enabled" ;; esac
    [ -x /usr/lib/systemd/system-generators/systemd-ssh-generator ] \
        || echo "systemd-ssh-generator is not among the system generators"
    [ -e /etc/systemd/system-generators/systemd-ssh-generator ] || [ -L /etc/systemd/system-generators/systemd-ssh-generator ] \
        && echo "systemd-ssh-generator is masked"
    return 0
}

# The system credentials systemd 262.2's generators read, from its
# systemd.system-credentials(7): a generator runs at every boot, enabled or not, so each is
# listed with what it reads unless masked. The units are found by their own credential
# settings (credential_consumers); PID 1 reads system.machine_id, system.hostname and
# vmm.notify_socket itself.
CREDENTIAL_GENERATORS='systemd-ssh-generator ssh.listen
systemd-fstab-generator fstab.extra
systemd-getty-generator getty.auto,getty.ttys.serial,getty.ttys.container
systemd-debug-generator systemd.extra-unit.*,systemd.unit-dropin.*
systemd-import-generator import.pull
systemd-imds-generator imds.*'
# credential_consumers: every consumer of a system credential in the image, the full set the
# hypervisor can feed (the Planner's ruling of 2026-11-16: list them, disable none yet).
# Prints one "list" line each: PID 1; each unit file whose own settings import or load a
# credential, with its enablement and whether the boot's targets pull it in; each
# generator of CREDENTIAL_GENERATORS present, or masked. Never a HIT.
credential_consumers() {
    local f u s pulled g c deps
    deps=$(systemctl list-dependencies --plain --all --no-pager default.target sockets.target 2>/dev/null | sed 's/^[^a-z]*//' | sort -u)
    echo "list credential consumer: PID 1 (systemd), system.machine_id system.hostname vmm.notify_socket"
    for f in $(grep -lE '^[[:space:]]*(ImportCredential|LoadCredential|LoadCredentialEncrypted|SetCredential)=' \
                 /usr/lib/systemd/system/*.service /usr/lib/systemd/system/*.socket /etc/systemd/system/*.service 2>/dev/null | LC_ALL=C sort -u); do
        u=${f##*/}
        s=$(systemctl is-enabled "$u" 2>/dev/null || true)
        pulled=no; grep -qxF -- "$u" <<<"$deps" && pulled=yes
        c=$(grep -hE '^[[:space:]]*(ImportCredential|LoadCredential|LoadCredentialEncrypted|SetCredential)=' "$f" | sed -E 's/^[^=]*=//' | tr '\n' ' ')
        echo "list credential consumer: $u (${s:-unknown}; pulled in at boot: $pulled): $c"
    done
    while read -r g c; do
        [ -e "/usr/lib/systemd/system-generators/$g" ] || continue
        if [ "$(readlink "/etc/systemd/system-generators/$g" 2>/dev/null)" = /dev/null ]; then s=masked; else s="runs at every boot"; fi
        echo "list credential consumer: generator $g ($s): $c"
    done <<<"$CREDENTIAL_GENERATORS"
}

# imds_check: the cloud metadata service's units masked and its generator masked. Prints
# each finding; exits 1 on any.
# updated_check: /etc/.updated and /var/.updated each name /usr's modification time, as
# systemd-update-done writes it (TIMESTAMP_NSEC, nanoseconds). Arch's systemd arms
# ConditionNeedsUpdate after every pacman transaction (its hook touches /usr); with both
# stamps at /usr's time the box's first boot runs no update unit (ldconfig, sysusers,
# update-done itself) and writes nothing the MANIFEST does not carry.
updated_check() {
    local u t d
    u=$(stat -c %.9Y /usr 2>/dev/null | tr -d .)
    [[ "$u" =~ ^[0-9]+$ ]] || { echo "the time of /usr could not be read"; return 0; }
    for d in /etc /var; do
        t=$(sed -n 's/^TIMESTAMP_NSEC=//p' "$d/.updated" 2>/dev/null)
        [ "$t" = "$u" ] || echo "$d/.updated names ${t:-no time}, not /usr's $u"
    done
    return 0
}
imds_check() {
    local u s bad=""
    for u in $IMDS_UNITS; do
        s=$(systemctl is-enabled "$u" 2>/dev/null)
        [ "$s" = masked ] || bad+="$u is ${s:-unknown}, not masked. "
    done
    [ "$(readlink "/etc/systemd/system-generators/$IMDS_GENERATOR" 2>/dev/null)" = /dev/null ] \
        || bad+="$IMDS_GENERATOR is not masked. "
    [ -z "$bad" ] || { echo "$bad"; return 1; }
}
# updates_check: each of UPDATE_UNITS masked, and pacman-init's file gone. Prints each
# finding; exits 1 on any.
updates_check() {
    local u s bad=""
    for u in $UPDATE_UNITS; do
        s=$(systemctl is-enabled "$u" 2>/dev/null)
        [ "$s" = masked ] || bad+="$u is ${s:-unknown}, not masked. "
    done
    [ "$(readlink /etc/systemd/system/pacman-init.service 2>/dev/null)" = /dev/null ] \
        || bad+="/etc/systemd/system/pacman-init.service is not a mask. "
    [ -z "$bad" ] || { echo "$bad"; return 1; }
}
# resolved_check: RESOLVED_DROPIN exactly as RESOLVED_SETTINGS holds it, no resolver address
# in resolved's configuration, and no other file of it naming LLMNR or multicast DNS (a
# later file would decide). Prints each finding; exits 1 on any.
resolved_check() {
    local bad="" f
    cmp -s <(printf '%s\n' "$RESOLVED_SETTINGS") "$RESOLVED_DROPIN" || bad+="$RESOLVED_DROPIN is not the image's settings. "
    # Each file read alone: under pipefail a pattern that matches no file would fail a pipe
    # and hide the finding.
    for f in /etc/systemd/resolved.conf /etc/systemd/resolved.conf.d/*.conf; do
        [ -f "$f" ] && grep -qE '^[[:space:]]*(DNS|FallbackDNS)=[^[:space:]]' "$f" && bad+="$f names a resolver address. "
    done
    for f in /etc/systemd/resolved.conf /etc/systemd/resolved.conf.d/*.conf /run/systemd/resolved.conf.d/*.conf \
             /usr/lib/systemd/resolved.conf.d/*.conf; do
        [ -f "$f" ] && [ "$f" != "$RESOLVED_DROPIN" ] && grep -qE '^[[:space:]]*(LLMNR|MulticastDNS)=' "$f" \
            && bad+="$f sets LLMNR or MulticastDNS. "
    done
    [ -z "$bad" ] || { echo "$bad"; return 1; }
}
# esp_partition: the one partition of the root's disk whose GPT type is the ESP's.
esp_partition() {
    local disk n
    disk=$(lsblk -nrpo PKNAME "$(findmnt -nvo SOURCE /)" 2>/dev/null | head -1)
    n=$(lsblk -nrpo PATH,PARTTYPE "$disk" 2>/dev/null | awk -v t="$ESP_TYPE" 'tolower($2) == t {print $1}')
    [ "$(wc -w <<<"$n")" = 1 ] || { echo "the root's disk ${disk:-unknown} has $(wc -w <<<"$n") ESPs, not one" >&2; return 1; }
    echo "$n"
}
# esp_mount: the ESP mounted at ESP_DIR by its UUID through one fstab line, root's alone.
esp_mount() {
    local part uuid line
    part=$(esp_partition) || return 1
    uuid=$(sudo blkid -s UUID -o value "$part") && [ -n "$uuid" ] || { echo "no UUID for $part"; return 1; }
    line="UUID=$uuid $ESP_DIR vfat umask=0077 0 2"
    sudo sed -i -E "\\|^[^#]*[[:space:]]$ESP_DIR[[:space:]]|d" /etc/fstab || return 1
    printf '%s\n' "$line" | sudo tee -a /etc/fstab >/dev/null || return 1
    sudo install -d -m 0755 "$ESP_DIR" || return 1
    findmnt -n "$ESP_DIR" >/dev/null || sudo mount "$ESP_DIR" || return 1
    echo "/etc/fstab: $line"
}
# esp_check: ESP_DIR is the ESP, mounted, vfat, through one fstab line naming it by UUID,
# and holds the loader the firmware's removable path boots. Prints each finding; exits 1
# on any.
esp_check() {
    local part uuid bad="" n
    part=$(esp_partition 2>&1) || bad+="$part. "
    uuid=$(sudo blkid -s UUID -o value "$part" 2>/dev/null)
    n=$(grep -cE "^[^#]*[[:space:]]$ESP_DIR[[:space:]]" /etc/fstab)
    [ "$n" = 1 ] || bad+="/etc/fstab names $ESP_DIR $n times, not once. "
    grep -qE "^UUID=$uuid[[:space:]]+$ESP_DIR[[:space:]]+vfat[[:space:]]" /etc/fstab || bad+="/etc/fstab does not mount the ESP (UUID ${uuid:-unknown}) at $ESP_DIR as vfat. "
    [ "$(findmnt -nvo SOURCE "$ESP_DIR" 2>/dev/null)" = "$part" ] || bad+="$ESP_DIR is not $part mounted. "
    sudo test -f "$ESP_DIR/EFI/BOOT/BOOTX64.EFI" || bad+="$ESP_DIR holds no EFI/BOOT/BOOTX64.EFI. "
    [ -z "$bad" ] || { echo "$bad"; return 1; }
}
# swap_check: no swap line in /etc/fstab, no swap subvolume, and no swap in use. Prints each
# finding; exits 1 on any.
swap_check() {
    local bad=""
    grep -qE '^[^#]*[[:space:]]swap[[:space:]]' /etc/fstab && bad+="/etc/fstab names a swap. "
    [ ! -e "$SWAP_SUBVOL" ] || bad+="$SWAP_SUBVOL stands. "
    [ -z "$(swapon --show --noheadings 2>/dev/null)" ] || bad+="a swap is in use: $(swapon --show --noheadings | tr '\n' ' '). "
    [ -z "$bad" ] || { echo "$bad"; return 1; }
}
# mounts_check: the data mount points as the image lays them: /mnt/weaver holding the two
# alone, and each a directory (not a link), root's, mode 0755, empty, and on the image's
# own filesystem, so nothing is mounted there in the build. Prints each finding; exits 1 on
# any.
mounts_check() {
    local bad="" d s n want
    want=$(for d in $DATA_MOUNTS; do echo "${d##*/}"; done | LC_ALL=C sort)
    [ "$(sudo ls -A /mnt/weaver 2>/dev/null | LC_ALL=C sort)" = "$want" ] || bad+="/mnt/weaver does not hold the two mount points alone. "
    for d in $DATA_MOUNTS; do
        s=$(sudo stat -c '%F %u:%g %a' -- "$d" 2>/dev/null)
        [ "$s" = "directory 0:0 755" ] || bad+="$d is '${s:-absent}', not a directory root's with mode 755. "
        n=$(sudo ls -A -- "$d" 2>/dev/null | wc -l)
        [ "$n" = 0 ] || bad+="$d holds $n entries. "
        [ "$(sudo stat -c %d -- "$d" 2>/dev/null)" = "$(sudo stat -c %d -- / 2>/dev/null)" ] || bad+="$d is not on the image's root filesystem. "
    done
    [ -z "$bad" ] || { echo "$bad"; return 1; }
}

# SEAL_KEYS: the private keys the seal removes, besides the SSH host keys: the pacman
# keyring this guest made at its first boot, whose master key is private.
SEAL_KEYS_DIR=/etc/pacman.d/gnupg
# private_keys: files that hold a private key. A .pem is judged by its content; the other
# names are keys by name; every file under the pacman keyring counts.
private_keys() {
    sudo find /etc /var /home /root /opt /usr/local -xdev -type f \( -name '*.priv' -o -name '*.key' -o -name '*_key' \
        -o -name 'id_rsa' -o -name 'id_ecdsa' -o -name 'id_ed25519' \) 2>/dev/null
    sudo find /etc /var /home /root /opt /usr/local -xdev -type f -name '*.pem' -exec grep -l 'PRIVATE KEY-----' {} + 2>/dev/null
    sudo find "$SEAL_KEYS_DIR" -xdev -type f 2>/dev/null
    return 0
}

# probes MODE: the seal's checks, each printed "ok" or "HIT". MODE pre runs over SSH before
# the final step; MODE final runs as root in it, after the build account, the identity
# and the logs are gone, and adds the checks only true then. Any HIT refuses the seal.
# Lines beginning "list" are records, never a HIT.
probes() {
    local mode=$1 hits=0 c p out
    hit() { printf 'HIT  %s\n' "$*"; hits=$((hits + 1)); }
    ok() { printf 'ok   %s\n' "$*"; }
    check() { # check NAME OUTPUT: a HIT when OUTPUT is not empty
        if [ -n "$2" ]; then hit "$1: $(head -c 600 <<<"$2" | tr '\n' ' ')"; else ok "$1"; fi
    }
    section "probes ($mode)"
    out=""
    for c in cc gcc g++ c++ cpp clang clang++ ld ld.bfd ld.gold as rustc cargo rustup rustfmt nvcc \
             ptxas fatbinary cicc make gmake cmake ninja meson dkms pkg-config pkgconf autoconf automake \
             libtool bison flex go git makepkg-template fakeroot; do
        p=$(PATH=/usr/local/sbin:/usr/local/bin:/usr/bin command -v "$c") && out+="$c=$p "
    done
    check "compilers, toolchains and build tools on PATH" "$out"
    check "compiler and toolchain directories" "$(sudo bash -c "ls -d /usr/lib/gcc /usr/libexec/gcc /usr/lib/clang /usr/lib/llvm* $CUDA_HOME/bin $CUDA_HOME/nvvm $CUDA_HOME/include $CUDA_HOME/targets/*/include /usr/include/cccl /root/.cargo /root/.rustup /home/*/.cargo /home/*/.rustup 2>/dev/null")"
    check "static or device-link CUDA archives" "$(find /usr/local "$CUDA_HOME" -xdev \( -name '*.a' -o -name '*_static*' \) 2>/dev/null | head -5)"
    check "build packages installed" "$(pacman -Qq 2>/dev/null | grep -E "$BUILD_RE")"
    check "test or sudo not GNU's and sudo's own" "$(o=$(pacman -Qoq /usr/bin/test 2>&1); [ "$o" = coreutils ] || echo "/usr/bin/test is ${o}'s"; o=$(pacman -Qoq /usr/bin/sudo 2>&1); [ "$o" = sudo ] || echo "/usr/bin/sudo is ${o}'s"; pacman -Qq uutils-coreutils sudo-rs 2>/dev/null)"
    # The man index carries a CACHEDIR.TAG of its own; it is not a build directory. A file
    # a package owns is the distribution's; only what no package owns is a hit.
    check "source trees and build directories" "$(sudo find / -xdev -path /var/cache/man -prune -o \( -name .git -o -name Cargo.toml -o -name Cargo.lock -o -name '*.rs' -o -name '*.cu' -o -name CACHEDIR.TAG -o -name .rustc_info.json -o -name WeaverAgent -o -name WeaverWeb \) -not -path '/proc/*' -print 2>/dev/null | while IFS= read -r f; do pacman -Qoq -- "$f" >/dev/null 2>&1 || echo "$f"; done | head -8)"
    check "package caches and sync databases" "$(sudo find /var/cache/pacman /var/lib/pacman/sync -xdev -type f 2>/dev/null | head -5)"
    check "package sources other than the snapshot" "$(pacman_sources_check /etc/pacman.conf /etc/pacman.d/mirrorlist)"
    check "update units not masked" "$(updates_check 2>&1)"
    check "the cloud metadata service not masked" "$(imds_check 2>&1)"
    check "a resolver address configured" "$(resolved_check 2>&1)"
    check "networkd or NetworkManager configuration" "$(for f in /etc/systemd/network/*.network /etc/systemd/network/*.netdev /etc/systemd/network/*.link /etc/NetworkManager/system-connections/*; do [ -e "$f" ] || [ -L "$f" ] || continue; echo "$f"; done; ls /usr/lib/systemd/network/*.network 2>/dev/null | while read -r f; do grep -qE '^[[:space:]]*Name=.*(eth|en)' "$f" && echo "$f"; done)"
    check "networkd or nouveau in the initramfs" "$(initrd_check 2>&1)"
    check "an agent configured" "$(sudo ls -A /etc/weaver/admin /var/lib/weaver-agent 2>&1 | grep -vE '^(/|$)')"
    check "the data mount points not as laid" "$(mounts_check 2>&1)"
    check "a swap" "$(swap_check 2>&1)"
    check "the ESP not mounted at $ESP_DIR" "$(esp_check 2>&1)"
    check "a connector config or unit" "$(ls -d /etc/weaver-web /etc/systemd/system/weaver-web-* 2>/dev/null)"
    check "the stack's members and shell" "$(for b in worker weaver-admin weaver-trace-relay weaver-gate weaver-spu weaver-state busybox busybox.applets; do [ -f "/opt/weaver/bin/$b" ] || echo "missing $b"; done)"
    check "the connectors' programs" "$(for b in gate-con admin-con; do [ -x "/opt/weaver-web/bin/$b" ] || echo "missing $b"; done)"
    check "the deploy scripts' copy" "$(for b in $DEPLOY_FILES; do [ -f "$DEPLOY_COPY/$b" ] || echo "missing $b"; done)"
    check "the loader" "$(loader_check >/dev/null 2>&1 || { echo "loader_check fails:"; loader_check 2>&1 | tail -4; })"
    # The toolkit's digests are the build's records, in the pre pass; in both passes the
    # package's files as built (pacman -Qkk: digest, size and mode against the package's
    # own list) and each runtime file the install tuple names, the package's.
    check "the CUDA runtime not as the toolkit had it" "$(if [ -d "$RUNTIME_DIR" ]; then runtime_check 2>&1; else pin_check "$RUNTIME_PKG" "${PIN_CUDA%-*}-1"; fi; pacman -Qkkq "$RUNTIME_PKG" 2>&1)"
    check "a CUDA runtime file the install tuple names, not the runtime package's" "$(tuple_runtime_check /etc/weaver/stack/install-tuple)"
    check "a unit link that leads nowhere" "$(unit_links_check)"
    check "one kernel" "$(one_kernel 2>&1)"
    check "the kernel or driver off its pin, or not held" "$(kernel_pins)"
    # The first boot's SSH step: sshd enabled, and sshdgenkeys, which it wants, makes the
    # host keys where none stands, so the seal removes them and the first boot makes them.
    # The operator reads the fingerprints after logging in (decision 16 of 2026-11-15).
    check "sshd not enabled for the first boot" "$(s=$(systemctl is-enabled sshd.service 2>/dev/null); [ "$s" = enabled ] || echo "sshd.service is ${s:-unknown}, not enabled")"
    check "sshd does not want sshdgenkeys" "$(grep -qx sshdgenkeys.service <<<"$(systemctl show -p Wants --value sshd.service 2>/dev/null | tr ' ' '\n')" || echo "sshd.service does not want sshdgenkeys.service")"
    check "cloud-init installed" "$(pacman -Qq cloud-init cloud-guest-utils 2>/dev/null; command -v cloud-init)"
    # SSH by key alone, and systemd's first-boot paths left and named (the operator's
    # rulings of 2026-11-16). In both passes: the settings are written by the cleanup.
    check "SSH settings not as built" "$(sshd_check 2>&1)"
    check "systemd's first-boot paths masked or missing" "$(firstboot_paths_check 2>&1)"
    credential_consumers
    # Who can log in. The pre pass leaves out the build account and root's two fields,
    # which the final step removes and sets.
    check "an account that can log in, other than as sealed" "$(sudo bash -c "$(declare -f accounts_judge); accounts_judge $mode /etc/passwd /etc/shadow /etc/gshadow /etc/shells /etc/shadow- /etc/gshadow-" 2>&1)"
    check "cloud-init's default account" "$(getent_absent passwd arch "the account arch"; ls -d /home/arch 2>/dev/null)"
    # The hostname: the image's own, and the build guest's name (the kernel's hostname,
    # which the seal does not change) nowhere in /etc. The pre pass leaves out the files the
    # final step removes.
    check "the image's hostname" "$(image_hostname_check "$mode")"
    check "the module" "$(driver_check_quiet)"
    check "the base inbound policy not as built" "$(firewall_check 2>&1)"
    # Private keys, in both passes, so a false hit is found before the seal's removals.
    # The pre pass leaves out what the seal itself removes (the pacman keyring and the SSH
    # host keys).
    check "private-key files" "$(private_keys | if [ "$mode" = pre ]; then grep -vE "^/etc/ssh/ssh_host_|^$SEAL_KEYS_DIR/"; else cat; fi | head -8)"
    # No key admits a login: the operator places the first one (decision 16). In both
    # passes, so a key is found before the seal's removals (the Planner's review of
    # 2026-11-15, F9). The pre pass leaves out the build account's own, which the seal
    # removes with the account.
    check "an authorized key" "$(sudo find /root /home /etc/ssh -xdev -type f \( -name authorized_keys -o -name authorized_keys2 \) -size +0 2>/dev/null | if [ "$mode" = pre ]; then grep -v '^/home/op/'; else cat; fi)"
    if [ "$mode" = final ]; then
        check "the build account" "$(getent_absent passwd op "the build account op"; getent_absent group op "the build account's group op"; ls -d /home/op /etc/sudoers.d/90-cloud-init-users 2>/dev/null)"
        check "shell histories" "$(find /root /home -xdev \( -name '.*_history' -o -name .lesshst -o -name .wget-hsts \) 2>/dev/null)"
        check "cloud-init's state and configuration" "$(ls -d /var/lib/cloud /etc/cloud 2>/dev/null; ls /var/log/cloud-init*.log 2>/dev/null)"
        # The machine identity must read uninitialized: that makes the first boot a first
        # boot. An empty or absent file is a hit (F8).
        check "machine identity" "$([ "$(cat /etc/machine-id 2>/dev/null)" = uninitialized ] || echo "machine-id is '$(head -c 40 /etc/machine-id 2>/dev/null)', not uninitialized"; ls /etc/ssh/ssh_host_* /var/lib/systemd/random-seed /var/lib/systemd/credential.secret /var/lib/dbus/machine-id 2>/dev/null)"
        check "the pacman keyring" "$(ls -d "$SEAL_KEYS_DIR" 2>/dev/null)"
        check "logs" "$(find /var/log -xdev -type f -size +0 2>/dev/null | head -5)"
        check "the build's records and harness" "$(ls -d "$BUILD" /usr/local/sbin/template-steps /usr/local/share/weaver-build 2>/dev/null)"
        check "the first boot's update armed: a stamp not at /usr's time" "$(updated_check 2>&1)"
        check "a stamp other than the one being sealed" "$(ls "$RECORD" 2>/dev/null | grep -vxE 'stamp.part|seal-probes')"
    fi
    printf '\nprobes (%s): %s hit(s)\n' "$mode" "$hits"
    [ "$hits" = 0 ]
}
# image_hostname_check MODE: /etc/hostname is IMAGE_HOSTNAME alone, and no file under /etc
# names the build guest (the kernel's hostname). MODE pre leaves out what seal_final removes:
# the SSH host keys and cloud-init's sudoers rule. Prints each finding.
image_hostname_check() {
    local build
    build=$(hostname)
    [ "$(cat /etc/hostname 2>/dev/null)" = "$IMAGE_HOSTNAME" ] || echo "/etc/hostname is '$(head -c 80 /etc/hostname 2>/dev/null)', not $IMAGE_HOSTNAME"
    if [ -z "$build" ] || [ "$build" = "$IMAGE_HOSTNAME" ]; then
        echo "the build guest's name ('$build') cannot be told from the image's"
        return 0
    fi
    # The name is matched whole, with no character a hostname carries on either side, so a
    # longer word it begins is not a finding: the default name, weaver-appliance-build,
    # begins weaver-appliance-build-Spec, which the image's nftables.conf names (the
    # Planner's review of 2026-11-15, B2). The final pass writes its own record,
    # seal-probes, under /etc while it runs: that file is left out.
    local re
    re=$(printf '%s' "$build" | sed 's/[][\\.*^$+?(){}|]/\\&/g')
    sudo grep -rlE -- "(^|[^A-Za-z0-9-])$re([^A-Za-z0-9-]|\$)" /etc 2>/dev/null | grep -vxF "$RECORD/seal-probes" | if [ "$1" = pre ]; then
        grep -vE "^/etc/(ssh/ssh_host_|sudoers\.d/90-cloud-init-users\$|pacman\.d/gnupg/)"; else cat; fi | head -8
    return 0
}
driver_check_quiet() {
    local m ver vm fw
    for m in nvidia nvidia-uvm nvidia-modeset; do
        ver=$(modinfo -k "$KVER" -F version "$m" 2>/dev/null) || { echo "no $m for $KVER"; continue; }
        vm=$(modinfo -k "$KVER" -F vermagic "$m" | cut -d' ' -f1)
        [ "$ver" = "${DRIVER:-$(cat "$BUILD/stamp.d/driver.version" 2>/dev/null)}" ] && [ "$vm" = "$KVER" ] || echo "$m is $ver for $vm"
    done
    modprobe -S "$KVER" --show-depends nvidia >/dev/null 2>&1 || echo "nvidia's dependencies do not resolve"
    for fw in $(modinfo -k "$KVER" -F firmware nvidia 2>/dev/null); do
        ls /lib/firmware/"$fw"* >/dev/null 2>&1 || echo "firmware $fw missing"
    done
}

# seal: the probes over SSH, then the final step handed to root, to run once this session
# has ended: it cannot remove the account it is logged in as.
seal() {
    local k want
    # Both commits recorded, and each the input the host names: a seal that would stamp
    # other commits than the ones asked for refuses here, before anything is removed.
    for k in weaveragent.commit:WA_COMMIT weaverweb.commit:WW_COMMIT; do
        want=${k##*:}; k=${k%%:*}
        [ -n "${!want:-}" ] || { echo "the seal needs $want, the commit the stamp's $k must name"; return 1; }
        grep -qxE '[0-9a-f]{40}' "$BUILD/stamp.d/$k" 2>/dev/null || { echo "the stamp has no $k (the trees step records it)"; return 1; }
        [ "$(cat "$BUILD/stamp.d/$k")" = "${!want}" ] || { echo "the stamp's $k is $(cat "$BUILD/stamp.d/$k"), not $want ${!want}"; return 1; }
    done
    # And the version: the one the facts step recorded, and the host's VERSION.
    [ -n "${VERSION:-}" ] || { echo "the seal needs VERSION, the version the stamp's appliance.version must name"; return 1; }
    [ "$(cat "$BUILD/stamp.d/appliance.version" 2>/dev/null)" = "$VERSION" ] \
        || { echo "the stamp's appliance.version is '$(cat "$BUILD/stamp.d/appliance.version" 2>/dev/null)', not VERSION $VERSION (the facts step records it)"; return 1; }
    # The image's own hostname was written by the cleanup; the probes judge it.
    echo "/etc/hostname: $(cat /etc/hostname) (the build guest runs as $(hostname))"
    probes pre || return 1
    # The system libraries the stack and connectors load, by package version and digest,
    # for the measurements that set this image against a host (WeaverTools#28).
    local f real key pkg ver
    for f in libc.so.6 libm.so.6 ld-linux-x86-64.so.2 libstdc++.so.6 libgcc_s.so.1; do
        real=$(readlink -f "/usr/lib/$f") && [ -f "$real" ] || { echo "no $f"; return 1; }
        key=syslib.$(tr '+_' 'p-' <<<"$f")
        pkg=$(pacman -Qoq -- "$real") && [ -n "$pkg" ] || { echo "no package owns $real"; return 1; }
        ver=$(pacman -Q -- "$pkg" | awk '{print $2}') && [ -n "$ver" ] || { echo "no version of $pkg"; return 1; }
        record_sha "$key" "$real" "${real##*/} $pkg=$ver sha256 " || return 1
    done
    sudo install -d -m 0700 /run/weaver-seal || return 1
    # The MANIFEST's file list and links list run here first, as root, to a scratch file in
    # /run: seal_final runs them again only after removals that cannot be undone, so a find
    # or a formatter that fails must fail here, with the guest intact and this step rerun.
    sudo /usr/local/sbin/template-steps manifest-dry /run/weaver-seal/MANIFEST.dry || return 1
    sudo rm -f /run/weaver-seal/MANIFEST.dry
    sudo install -m 0755 /usr/local/sbin/template-steps /run/weaver-seal/template-steps || return 1
    sudo systemd-run --unit=weaver-seal-final --no-block --property=Type=oneshot \
        --setenv=HOME=/root --setenv=DRIVER="${DRIVER:-$(cat "$BUILD/stamp.d/driver.version")}" \
        /run/weaver-seal/template-steps seal-final || return 1
    echo "the final step runs as root once this session ends; it powers the guest off"
}

# The MANIFEST's form (changed after the fourth build; the third and fourth used the
# earlier form, regular files only). First every regular file in the scope, as sha256sum
# writes it; then the marker line LINKS_MARK; then one line per symbolic link in the same
# scope: its path, a tab, and its target as stored, each with backslash, tab and newline
# escaped as \\, \t and \n. Both parts in C-locale order. A mask is a link, so the links
# section is what lets the identity see a unit masked or unmasked. The two lines below are
# the form's one definition: lib.sh reads both from this file. links_format is the one
# formatter text, which lib.sh carries word for word for proof's read of a booted guest;
# the offline mock checks that the two copies are equal. The scope's ESP is at /efi on
# this base (ESP_DIR).
LINKS_MARK='# links: path TAB target, C-locale order'
MANIFEST_SCOPE='/usr /etc /opt /boot /efi'
links_format() {
    local p t
    while IFS= read -r -d '' p && IFS= read -r -d '' t; do
        p=${p//\\/\\\\}; p=${p//$'\t'/\\t}; p=${p//$'\n'/\\n}
        t=${t//\\/\\\\}; t=${t//$'\t'/\\t}; t=${t//$'\n'/\\n}
        printf '%s\t%s\n' "$p" "$t"
    done | LC_ALL=C sort -u
}
# links_list: the links section's lines, from find's NUL-separated path and target pairs.
# find's errors are not discarded: in seal_final they reach seal-final.log.
links_list() {
    # shellcheck disable=SC2086
    find $MANIFEST_SCOPE -xdev -type l -printf '%p\0%l\0' | links_format
}
# manifest_write OUT: the MANIFEST in the form above.
manifest_write() {
    {
        # shellcheck disable=SC2086
        find $MANIFEST_SCOPE -xdev -type f -not -path "$RECORD/MANIFEST*" \
            -not -path /boot/grub/grubenv -print0 | LC_ALL=C sort -zu | xargs -0 sha256sum &&
            printf '%s\n' "$LINKS_MARK" && links_list
    } >"$1"
}
# manifest_dry OUT: the MANIFEST written to OUT and its form checked, as root, from the seal
# step and before anything is removed: each file line a digest and a path (sha256sum puts a
# backslash first where it escapes the name), the marker once, each link line a path, one
# tab and a target, and at least one of each.
manifest_dry() {
    local out=$1 files links bad
    manifest_write "$out" || { echo "the MANIFEST's dry run failed (find, sort, sha256sum or the links list; errors above)"; return 1; }
    [ "$(grep -cxF "$LINKS_MARK" "$out")" = 1 ] || { echo "the dry run's MANIFEST does not carry the marker once"; return 1; }
    files=$(M=$LINKS_MARK awk '$0 == ENVIRON["M"] { exit } 1' "$out" | wc -l)
    links=$(manifest_links "$out" | wc -l)
    bad=$(( $(M=$LINKS_MARK awk '$0 == ENVIRON["M"] { exit } 1' "$out" | grep -cvE '^\\?[0-9a-f]{64}  .' || true)
            + $(manifest_links "$out" | awk -F '\t' 'NF != 2' | wc -l) ))
    echo "MANIFEST dry run: $files files, $links links, $bad lines out of form"
    [ "$files" -gt 0 ] && [ "$links" -gt 0 ] && [ "$bad" = 0 ]
}
# manifest_links FILE: the MANIFEST's links section (lib.sh has the same function).
manifest_links() { M=$LINKS_MARK awk '$0 == ENVIRON["M"] { l = 1; next } l' "$1"; }

# seal_final: as root, from /run. Waits for the build account's sessions to end, removes
# the account, the identity, the keys and the logs, runs the probes again, and writes the
# stamp and then the MANIFEST last. A probe that hits writes SEAL-REFUSED and no MANIFEST.
# Either way the guest powers off; the host reads the verdict from the image
# (build-template.sh proof).
seal_final() {
    local log=/run/weaver-seal/final.log t=0 k u
    exec >"$log" 2>&1
    sudo() { "$@"; }   # root already; the shared checks call sudo
    echo "seal-final started $(date -u +%FT%TZ)"
    while pgrep -u op >/dev/null 2>&1 && [ "$t" -lt 120 ]; do sleep 2; t=$((t + 2)); done
    loginctl terminate-user op 2>/dev/null || true
    systemctl stop "user@$(id -u op 2>/dev/null || echo 1000).service" 2>/dev/null || true
    pkill -KILL -u op 2>/dev/null || true; sleep 1
    userdel -r op 2>&1 || true
    getent group op >/dev/null && groupdel op
    # cloud-init's default account, where a seed ever made it (the build's seed names op
    # alone): the account, its home and its sudoers rule (the Planner's ruling of
    # 2026-11-16). The probes read it absent.
    for u in arch; do
        ! getent passwd "$u" >/dev/null || userdel -r "$u" 2>&1 || true
        ! getent group "$u" >/dev/null || groupdel "$u" 2>&1 || true
        rm -rf -- "/home/$u"
    done
    rm -f /etc/sudoers.d/90-cloud-init-users
    # Root, set at the first login (the operator's ruling of 2026-11-16): the password field
    # emptied (Arch ships it locked, '*') and the last change put at 0, so the console's
    # login asks for no password and requires a new one before the shell. SSH refuses every
    # password (SSHD_SETTINGS), so the first password is set at the console, and the image
    # carries none. Every other account stays locked as shipped. The final probe reads both
    # fields back.
    passwd -d root 2>&1; chage -d 0 root 2>&1
    echo "root: $(passwd -S root 2>&1)"
    # SSH stays enabled with no host key and no authorized key: at the first boot
    # sshdgenkeys makes the host keys where none stands, and the operator, logged in at the
    # console, places a key and reads the fingerprints (decision 16 of 2026-11-15).
    # systemd's random seed and its credential secret are per machine: no copy of the image
    # ships either. systemd-random-seed.service saves a seed when it stops, so left running
    # it would write one at the power-off, after the final probe. It is stopped first (its
    # stop saves a seed, removed next), and a stopped unit is not stopped again at the
    # power-off. proof reads the sealed image for both files.
    systemctl stop systemd-random-seed.service 2>&1
    echo "systemd-random-seed.service: $(systemctl is-active systemd-random-seed.service 2>&1)"
    rm -f /etc/ssh/ssh_host_* /var/lib/systemd/random-seed /var/lib/systemd/credential.secret /var/lib/dbus/machine-id
    # The pacman keyring, made at this guest's first boot: its master key is private, and
    # nothing installs after the seal.
    rm -rf -- "$SEAL_KEYS_DIR"
    # What cloud-init left once its package went: its state, its logs, any configuration
    # left unowned. The machine identity uninitialized, so a box's first boot is a first
    # boot (systemd makes the identity then).
    rm -rf -- /var/lib/cloud /etc/cloud
    rm -f /var/log/cloud-init.log /var/log/cloud-init-output.log
    printf 'uninitialized\n' >/etc/machine-id
    rm -f /root/.bash_history /root/.lesshst /root/.wget-hsts /root/.python_history
    rm -rf /tmp/* /var/tmp/* 2>/dev/null
    journalctl --rotate -q; journalctl --vacuum-time=1s -q; journalctl --relinquish-var 2>&1
    rm -rf /var/log/journal/*
    find /var/log -xdev -type f \( -name '*.gz' -o -name '*.[0-9]' -o -name '*.old' \) -delete
    find /var/log -xdev -type f -exec truncate -s 0 {} +
    # The stamp is assembled from the build's records, which then go with the harness, so
    # the probes see the image as it will be sealed.
    install -d -o root -g root -m 0755 "$RECORD"
    {
        printf 'sealed = %s\n' "$(date -u +%FT%TZ)"
        for k in $(ls "$BUILD/stamp.d" | sort); do printf '%s = %s\n' "$k" "$(cat "$BUILD/stamp.d/$k")"; done
        printf 'manifest.scope = %s\n' "$MANIFEST_SCOPE, regular files less the MANIFEST and /boot/grub/grubenv, then symbolic links (path and target)"
    } >"$RECORD/stamp.part"
    # The stamp must name both commits and the version: an image whose stamp does not
    # cannot say what code it was compiled from, or which version it is.
    local commits=1
    for k in weaveragent.commit weaverweb.commit; do
        grep -qE "^$k = [0-9a-f]{40}\$" "$RECORD/stamp.part" || commits=0
    done
    grep -qE '^appliance\.version = [1-9][0-9]*\.0$' "$RECORD/stamp.part" || commits=0
    rm -rf -- "$BUILD" /usr/local/sbin/template-steps /usr/local/share/weaver-build
    # The update the build's pacman hooks armed, marked done (updated_check): the loader
    # cache rebuilt once more as ldconfig.service would, then both stamps written at /usr's
    # time. Nothing touches /usr after this line.
    ldconfig -X 2>&1
    /usr/lib/systemd/systemd-update-done 2>&1
    echo "update stamps: $(sed -n 's/^TIMESTAMP_NSEC=//p' /etc/.updated 2>&1), /usr $(stat -c %.9Y /usr)"
    if ! probes final >"$RECORD/seal-probes" 2>&1 || [ "$commits" = 0 ]; then
        [ "$commits" = 1 ] || echo "REFUSED: the stamp does not name weaveragent.commit, weaverweb.commit and appliance.version" >>"$RECORD/seal-probes"
        rm -f "$RECORD/stamp.part"
        cp "$RECORD/seal-probes" "$RECORD/SEAL-REFUSED"
        echo "SEAL REFUSED; no stamp, no MANIFEST"
        cp "$log" "$RECORD/seal-final.log"
    else
        mv "$RECORD/stamp.part" "$RECORD/stamp"
        echo "probes passed; writing the MANIFEST $(date -u +%FT%TZ)"
        cp "$log" "$RECORD/seal-final.log"
        chmod 0644 "$RECORD/stamp" "$RECORD/seal-probes" "$RECORD/seal-final.log"
        # The MANIFEST last: regular files, then links. If it cannot be written whole, the
        # stamp goes too and the seal refuses: an image with a stamp and no MANIFEST is not
        # sealed.
        if manifest_write "$RECORD/MANIFEST.part" \
            && mv "$RECORD/MANIFEST.part" "$RECORD/MANIFEST" && chmod 0644 "$RECORD/MANIFEST"; then
            echo "stamp and MANIFEST written: $(M=$LINKS_MARK awk '$0 == ENVIRON["M"] { l = 1; next } { if (l) n++; else f++ } END { print f + 0 " files, " n + 0 " links" }' "$RECORD/MANIFEST")"
        else
            rm -f "$RECORD/MANIFEST.part" "$RECORD/MANIFEST" "$RECORD/stamp"
            echo "the MANIFEST could not be written whole $(date -u +%FT%TZ)" >"$RECORD/SEAL-REFUSED"
            echo "SEAL REFUSED: the MANIFEST could not be written; no stamp, no MANIFEST"
            cp "$log" "$RECORD/seal-final.log"
        fi
    fi
    sync; fstrim -av
    echo "seal-final done $(date -u +%FT%TZ); powering off"
    systemctl poweroff
}

case ${1:-} in
facts) facts ;;
os-probes) os_probes ;;
packages) packages ;;
rustup) rustup_install ;;
trees) trees ;;
toolkit) toolkit ;;
stack) stack ;;
connectors) connectors ;;
driver) driver ;;
cleanup) cleanup ;;
probes) probes pre ;;
seal) seal ;;
seal-final) seal_final ;;
manifest-dry) manifest_dry "${2:?manifest-dry OUT}" ;;
*) echo "unknown step: ${1:-}" >&2; exit 2 ;;
esac
